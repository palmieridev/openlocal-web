---
import AccountActivity from "@/components/account/AccountActivity.astro";
import { Icon } from "astro-icon/components";
import { clerkClient } from "@clerk/astro/server";
import ClerkLocalization from "@/components/ClerkLocalization.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";
import Button from "@/components/ui/Button.astro";
import { localePath, useT } from "@/i18n";
import { hasAdminAccess } from "@/lib/api/admin";

const locale = Astro.locals.locale;
const t = useT(locale).account;
const adminT = useT(locale).admin;
const to = (path: string) => localePath(locale, path);
const { userId, orgId } = Astro.locals.auth();
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
const adminAccess = hasAdminAccess(Astro.locals);

// Fetch every membership, including when an organization is already active.
let businesses: { id: string; name: string }[] = [];
let membershipError = false;
if (userId) {
  try {
    const client = clerkClient(Astro);
    let offset = 0;
    while (true) {
      const page = await client.users.getOrganizationMembershipList({ userId, limit: 100, offset });
      businesses.push(...page.data.map(({ organization }) => ({ id: organization.id, name: organization.name })));
      offset += page.data.length;
      if (!page.data.length || offset >= page.totalCount) break;
    }
  } catch {
    membershipError = true;
    businesses = [];
  }
}
const showAdmin = await adminAccess;
---

<PublicLayout title={t.title}>
  <div class="mx-auto max-w-5xl space-y-8 px-4 py-8 sm:px-6 sm:py-12">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="font-heading text-3xl font-semibold tracking-tight">{t.title}</h1>
        <p class="mt-2 text-text-secondary">{t.intro}</p>
      </div>
      <Button href={to("/marketplace")} variant="secondary" icon="lucide:search">{t.explore}</Button>
    </div>

    <a href={to("/account/profile")} class="ol-card flex items-center gap-4 p-6 transition-colors hover:bg-surface-secondary">
      <Icon name="lucide:user-round" width={24} height={24} class="shrink-0 text-accent" />
      <div class="min-w-0 flex-1">
        <h2 class="font-heading text-lg font-semibold">{t.profile}</h2>
        <p class="mt-1 text-sm text-text-secondary">{t.profileDescription}</p>
      </div>
      <Icon name="lucide:chevron-right" width={20} height={20} class="shrink-0" />
    </a>

    {showAdmin && <a href={to("/admin")} class="ol-card flex items-center gap-4 p-6 transition-colors hover:bg-surface-secondary">
      <Icon name="lucide:shield-check" width={24} height={24} class="shrink-0 text-accent" />
      <div class="min-w-0 flex-1">
        <h2 class="font-heading text-lg font-semibold">{adminT.title}</h2>
        <p class="mt-1 text-sm text-text-secondary">{adminT.accountDescription}</p>
      </div>
      <Icon name="lucide:chevron-right" width={20} height={20} class="shrink-0" />
    </a>}

    <section class="ol-card space-y-4 p-6" aria-labelledby="business-heading" data-business-access data-dashboard-url={to("/dashboard")}>
      <h2 id="business-heading" class="font-heading text-xl font-semibold">{t.business}</h2>
      {membershipError ? <p role="status" class="text-sm text-text-secondary">{t.membershipError}</p> : businesses.length ? (
        <>
          <p class="text-sm text-text-secondary">{t.businessDescription}</p>
          <ul class="grid gap-3 sm:grid-cols-2">
            {businesses.map((business) => (
              <li class="flex min-w-0 flex-col items-start gap-4 rounded-xl border border-border p-4">
                <div class="flex w-full flex-wrap items-center gap-2">
                  <h3 class="min-w-0 break-words font-semibold">{business.name}</h3>
                  {business.id === orgId && <span class="rounded-full bg-accent-soft px-2 py-1 text-xs text-accent">{t.activeBusiness}</span>}
                </div>
                <Button data-manage-business={business.id} disabled icon="lucide:store" class="min-h-11">
                  <span data-button-label>{t.manageBusiness}</span><span class="sr-only"> · {business.name}</span>
                </Button>
              </li>
            ))}
          </ul>
          <p data-business-message role="status" aria-live="polite" class="text-sm text-text-secondary"></p>
          <noscript><p class="text-sm text-text-secondary">{t.switchRequiresJs}</p></noscript>
          <a class="inline-block text-sm font-medium text-accent underline" href={to("/onboarding")}>{t.startBusiness}</a>
        </>
      ) : (
        <>
          <p class="text-sm text-text-secondary">{t.startDescription}</p>
          <Button href={to("/onboarding")} variant="secondary" icon="lucide:store">{t.startBusiness}</Button>
        </>
      )}
    </section>

    <AccountActivity />
  </div>
  <ClerkLocalization />
</PublicLayout>

<script>
  import { $clerkStore, $isLoadedStore } from "@clerk/astro/client";
  import { ui } from "@/lib/i18n-client";

  const root = document.querySelector<HTMLElement>("[data-business-access]");
  if (root) {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-manage-business]"));
    const message = root.querySelector<HTMLElement>("[data-business-message]");
    let switching = false;
    const updateButtons = () => {
      for (const button of buttons) button.disabled = switching || !$isLoadedStore.get();
    };
    $isLoadedStore.subscribe(updateButtons);
    for (const button of buttons) {
      button.addEventListener("click", async () => {
        if (switching) return;
        const label = button.querySelector<HTMLElement>("[data-button-label]")!;
        const t = ui().account;
        switching = true;
        updateButtons();
        if (message) message.textContent = "";
        label.textContent = t.switchingBusiness;
        try {
          const clerk = $clerkStore.get();
          const organization = button.dataset.manageBusiness!;
          if (!clerk?.user) throw new Error("signed out");
          await clerk.setActive({ organization });
          // Use a fresh token to resolve the business for the new organization,
          // before navigating with a cookie that may still name the old one.
          const token = await clerk.session?.getToken({ skipCache: true });
          if (!token) throw new Error("session unavailable");
          const response = await fetch("/api/businesses/active", {
            method: "POST",
            headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
            body: JSON.stringify({ organization }),
          });
          if (!response.ok) throw new Error("business unavailable");
          window.location.assign(root.dataset.dashboardUrl!);
        } catch {
          if (message) message.textContent = t.switchBusinessError;
          label.textContent = t.manageBusiness;
          switching = false;
          updateButtons();
        }
      });
    }
  }
</script>
