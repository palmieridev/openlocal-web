---
import { UserProfile } from "@clerk/astro/components";
import ClerkLocalization from "@/components/ClerkLocalization.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";
import { localePath, useT } from "@/i18n";
const locale = Astro.locals.locale;
const t = useT(locale).account;
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
---
<PublicLayout title={t.profile}>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    <a href={localePath(locale, "/account")} class="text-sm text-text-secondary hover:text-text-primary">← {t.title}</a>
    <h1 class="mb-6 mt-4 font-heading text-2xl font-semibold">{t.profile}</h1>
    <UserProfile routing="hash" />
  </div>
  <ClerkLocalization />
</PublicLayout>
