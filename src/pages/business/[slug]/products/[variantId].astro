---
import PublicLayout from '@/layouts/PublicLayout.astro';
import ProductCard from '@/components/ui/ProductCard.astro';
import ShareLinks from '@/components/ui/ShareLinks.astro';
import Button from '@/components/ui/Button.astro';
import ImageLightbox from '@/components/ui/ImageLightbox.astro';
import { publicApi } from '@/lib/api/client';
import { publicPriceNote, publicVariantDescription } from '@/lib/variants';
import { shareImage, variantUrl } from '@/lib/sharing';
import { formatPrice, text } from '@/lib/format';
import { localePath, useT } from '@/i18n';

const locale = Astro.locals.locale;
const t = useT(locale);
const { slug, variantId } = Astro.params;
const business = slug ? await publicApi.getBusiness(slug) : null;
// Never resolve a variant through owner APIs: only currently public rows qualify.
const products = business ? await publicApi.getBusinessProducts(business.slug) : [];
const product = products.find(p => p.variant_id === variantId);
if (!business || !product) Astro.response.status = 404;
const name = product ? [product.name, product.variant_name].filter(Boolean).join(' · ') : '';
const description = product ? [formatPrice(product.price, product.currency, locale), publicPriceNote(product), publicVariantDescription(product) || product.description, business?.name].filter(Boolean).join(' · ') : t.shareStorefront.notFoundBody;
const phone = business?.whatsapp || business?.phone;
const whatsapp = phone ? `https://wa.me/${phone.replace(/[^\d]/g, '')}?text=${encodeURIComponent(`${name}\n${variantUrl(Astro.url, business!.slug, variantId!, locale)}`)}` : null;
---
<PublicLayout title={product ? `${name} — ${business!.name} — Openlocal` : t.shareStorefront.notFound} description={description} image={business && product ? shareImage(business, product, locale) : undefined} imageAlt={name}>
  <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    {business && product ? <>
      <a href={localePath(locale, `/business/${business.slug}`)} class="text-sm font-medium text-accent hover:underline">{business.name} · {t.shareStorefront.backToShop}</a>
      <h1 class="mt-5 font-heading text-3xl font-semibold">{name}</h1>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <ProductCard name={product.name} meta={[text(product.brand), product.variant_name].filter(Boolean).join(' · ')} price={product.price} currency={product.currency} priceNote={publicPriceNote(product)} stockStatus={product.public_stock_status} imageUrl={product.image_url} lightbox />
        <div class="flex flex-col gap-5">
          {publicVariantDescription(product) && <p class="whitespace-pre-line text-text-secondary">{publicVariantDescription(product)}</p>}
          {product.description && <p class="whitespace-pre-line text-sm text-text-secondary">{product.description}</p>}
          {whatsapp && <Button href={whatsapp} variant="whatsapp" icon="lucide:message-circle">{t.storefront.contactWhatsapp}</Button>}
          <ShareLinks url={variantUrl(Astro.url, business.slug, product.variant_id, locale)} title={`${name} · ${formatPrice(product.price, product.currency, locale)} · ${business.name}`} />
        </div>
      </div>
      <ImageLightbox />
    </> : <div class="py-16 text-center">
      <h1 class="font-heading text-2xl font-semibold">{t.shareStorefront.notFound}</h1>
      <p class="my-5 text-text-secondary">{t.shareStorefront.notFoundBody}</p>
      <Button href={localePath(locale, business ? `/business/${business.slug}` : '/marketplace')}>{business ? t.shareStorefront.backToShop : t.storefront.exploreMarketplace}</Button>
    </div>}
  </section>
</PublicLayout>
