---
import PublicLayout from "@/layouts/PublicLayout.astro";
import RequestForm from "@/components/modules/RequestForm.astro";
import { localePath, useT } from "@/i18n";
const t = useT(Astro.locals.locale).modules;
Astro.response.headers.set("Cache-Control", "private, no-store");
---

<PublicLayout title={t.requestPreorder}
  ><main class="module-page">
    <a href={localePath(Astro.locals.locale, `/business/${Astro.params.slug}`)}
      >← {t.backToStorefront}</a
    ><h1>{t.requestPreorder}</h1><RequestForm
      module="preorders"
      slug={Astro.params.slug!}
    />
  </main></PublicLayout
>
