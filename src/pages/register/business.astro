---
import { SignUp } from "@clerk/astro/components";
import AuthLayout from "@/layouts/AuthLayout.astro";
import ClerkLocalization from "@/components/ClerkLocalization.astro";
import { localePath, useT } from "@/i18n";

const locale = Astro.locals.locale;
const t = useT(locale);

// Business signup: plain account, then onboarding creates the business + Clerk
// org via our API (POST /api/businesses). Clerk's forced org task is disabled.
---

<AuthLayout title={t.auth.businessPageTitle}>
  <SignUp
    signInUrl={localePath(locale, "/login")}
    fallbackRedirectUrl={localePath(locale, "/onboarding")}
  />
  <a
    href={localePath(locale, "/register")}
    class="text-sm text-text-muted hover:text-text-secondary"
  >
    {t.auth.otherOptions}
  </a>
  <ClerkLocalization />
</AuthLayout>
