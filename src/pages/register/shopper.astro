---
import { SignUp } from "@clerk/astro/components";
import { authReturnPath, authFlowLink } from "@/lib/auth-return";
import AuthLayout from "@/layouts/AuthLayout.astro";
import ClerkLocalization from "@/components/ClerkLocalization.astro";
import { localePath, useT } from "@/i18n";

const locale = Astro.locals.locale;
const returnPath = authReturnPath(Astro.url);
const t = useT(locale);

// Shopper signup: plain account, no organization. Lands on the personal account.
---

<AuthLayout title={t.auth.shopperPageTitle}>
  <SignUp
    signInUrl={authFlowLink(localePath(locale, "/login"), returnPath)}
    forceRedirectUrl={returnPath}
    fallbackRedirectUrl={localePath(locale, "/account")}
  />
  <a
    href={authFlowLink(localePath(locale, "/register"), returnPath)}
    class="text-sm text-text-muted hover:text-text-secondary"
  >
    {t.auth.otherOptions}
  </a>
  <ClerkLocalization />
</AuthLayout>
