---
import { Icon } from "astro-icon/components";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import AnalyticsTabs from "@/components/dashboard/AnalyticsTabs.astro";
import NeedsSetup from "@/components/dashboard/NeedsSetup.astro";
import Button from "@/components/ui/Button.astro";
import { getServerAuth } from "@/lib/api/server";
import { authedApi } from "@/lib/api/client";
import type { LowStockRow } from "@/types/api";

const { token, businessId } = await getServerAuth(Astro);

let rows: LowStockRow[] = [];
let loadError = false;
if (token && businessId) {
  try {
    rows = await authedApi(token, businessId).lowStock(200);
  } catch {
    loadError = true;
  }
}
---

<DashboardLayout active="analitica">
  {!businessId ? (
    <NeedsSetup reason="no-business" />
  ) : loadError ? (
    <NeedsSetup reason="error" />
  ) : (
    <>
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-border bg-surface-card px-8 py-5">
        <h1 class="font-heading text-2xl font-semibold">Analítica</h1>
        <Button variant="secondary" size="sm" icon="lucide:scan-barcode" href="/dashboard/inventory/scan">Escanear</Button>
      </div>
      <div class="mx-auto max-w-4xl px-8 py-6">
        <AnalyticsTabs active="low-stock" />

      {rows.length > 0 ? (
        <div class="ol-card mt-6 overflow-hidden">
          <div class="flex items-center gap-2 border-b border-border px-5 py-3">
            <Icon name="lucide:triangle-alert" class="text-warning" width={18} height={18} />
            <h2 class="font-heading font-semibold">{rows.length} productos por reordenar</h2>
          </div>
          <ul class="divide-y divide-border">
            {rows.map((r) => (
              <li class="flex items-center justify-between px-5 py-3">
                <div>
                  <div class="font-medium text-text-primary">{r.product_name ?? r.sku ?? r.variant_id}</div>
                  {r.sku && <div class="font-data text-xs text-text-muted">{r.sku}</div>}
                </div>
                <div class="flex items-center gap-4">
                  <span class="text-right">
                    <span class="block font-data text-danger">{r.quantity_on_hand}</span>
                    <span class="block text-[11px] text-text-muted">reorden ≤ {r.reorder_point}</span>
                  </span>
                  <Button variant="secondary" size="sm" href="/dashboard/inventory" icon="lucide:plus">Reabastecer</Button>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <div class="ol-card mt-6 border-dashed p-12 text-center">
          <Icon name="lucide:check-check" class="mx-auto text-success" width={32} height={32} />
          <p class="mt-3 text-sm text-text-secondary">Todo en orden. Ningún producto bajo el punto de reorden.</p>
        </div>
      )}
      </div>
    </>
  )}
</DashboardLayout>
