---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import AnalyticsTabs from "@/components/dashboard/AnalyticsTabs.astro";
import NeedsSetup from "@/components/dashboard/NeedsSetup.astro";
import Button from "@/components/ui/Button.astro";
import { getServerAuth } from "@/lib/api/server";
import { useT } from "@/i18n";

const locale = Astro.locals.locale;
const t = useT(locale).analytics;

const { businessId } = await getServerAuth(Astro);
---

<DashboardLayout active="analitica">
  {!businessId ? (
    <NeedsSetup reason="no-business" />
  ) : (
    <>
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-border bg-surface-card px-8 py-5">
        <h1 class="font-heading text-2xl font-semibold">{t.title}</h1>
      </div>
      <div class="mx-auto max-w-xl px-8 py-6" data-business-id={businessId}>
        <AnalyticsTabs active="eoq" />

      <form id="eoq-form" class="ol-card mt-6 flex flex-col gap-4 p-6">
        <h2 class="font-heading font-semibold">{t.eoqTitle}</h2>
        <p class="-mt-2 text-sm text-text-secondary">{t.eoqIntro}</p>
        <div>
          <label class="ol-label" for="search">{t.skuOrBarcode}</label>
          <div class="flex gap-2">
            <input class="ol-input font-data" id="search" placeholder="BOLSA-001" />
            <Button variant="secondary" size="sm" id="search-btn">{t.search}</Button>
          </div>
          <p id="search-msg" class="mt-2 hidden text-sm"></p>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="ol-label" for="period_days">{t.periodDays}</label>
            <input class="ol-input font-data" id="period_days" value="90" inputmode="numeric" />
          </div>
          <div>
            <label class="ol-label" for="order_cost">{t.orderCost}</label>
            <input class="ol-input font-data" id="order_cost" value="100" inputmode="decimal" />
          </div>
          <div>
            <label class="ol-label" for="holding">{t.holdingPct}</label>
            <input class="ol-input font-data" id="holding" value="20" inputmode="decimal" />
          </div>
        </div>
        <div class="flex justify-end">
          <Button type="submit" variant="primary" id="calc-btn">
            <span data-label>{t.calculate}</span>
          </Button>
        </div>
      </form>

      <div id="eoq-result" class="mt-4 hidden"></div>
      </div>
    </>
  )}
</DashboardLayout>

<script>
  import { interpolate } from "@/i18n";
  import { ui } from "@/lib/i18n-client";

  const t = ui().analytics;
  const root = document.querySelector("[data-business-id]") as HTMLElement | null;
  if (root) {
    const businessId = root.dataset.businessId!;
    let variantId: string | null = null;

    const searchInput = document.getElementById("search") as HTMLInputElement;
    const searchMsg = document.getElementById("search-msg") as HTMLElement;
    const resultEl = document.getElementById("eoq-result") as HTMLElement;

    async function lookup() {
      const q = searchInput.value.trim();
      if (!q) return;
      const param = /^\d{6,}$/.test(q) ? "barcode" : "sku";
      const res = await fetch(`/api/lookup?${param}=${encodeURIComponent(q)}&business_id=${businessId}`);
      const data = await res.json();
      if (res.ok) {
        variantId = data.id;
        searchMsg.className = "mt-2 text-sm text-success";
        searchMsg.textContent = interpolate(t.variantFound, { name: data.name || data.sku });
      } else {
        variantId = null;
        searchMsg.className = "mt-2 text-sm text-danger";
        searchMsg.textContent = data?.error || t.notFound;
      }
      searchMsg.classList.remove("hidden");
    }

    document.getElementById("search-btn")?.addEventListener("click", (e) => { e.preventDefault(); lookup(); });

    document.getElementById("eoq-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!variantId) { searchMsg.className = "mt-2 text-sm text-danger"; searchMsg.textContent = t.searchFirst; searchMsg.classList.remove("hidden"); return; }
      const params = new URLSearchParams({
        business_id: businessId,
        variant_id: variantId,
        period_days: (document.getElementById("period_days") as HTMLInputElement).value || "90",
        estimated_order_cost: (document.getElementById("order_cost") as HTMLInputElement).value || "100",
        estimated_holding_cost_percent: (document.getElementById("holding") as HTMLInputElement).value || "20",
      });
      const res = await fetch(`/api/eoq?${params}`);
      const d = await res.json();
      if (!res.ok) {
        resultEl.className = "ol-card mt-4 p-5 text-sm text-danger";
        resultEl.textContent = d?.error || t.calcError;
        resultEl.classList.remove("hidden");
        return;
      }
      const eoq = Math.round(Number(d.estimated_eoq));
      resultEl.className = "ol-card mt-4 p-6";
      resultEl.innerHTML = `
        <div class="text-sm text-text-secondary">${t.eoqLabel}</div>
        <div class="font-data text-4xl font-semibold mt-1">${eoq} <span class="text-base text-text-muted">${t.units}</span></div>
        <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
          <div class="rounded-xl bg-surface-secondary px-3 py-2"><span class="text-text-muted">${t.demandPeriod}</span><div class="font-data">${d.demand}</div></div>
          <div class="rounded-xl bg-surface-secondary px-3 py-2"><span class="text-text-muted">${t.holdingRate}</span><div class="font-data">${(Number(d.holding_cost_rate) * 100).toFixed(0)}%</div></div>
        </div>`;
      resultEl.classList.remove("hidden");
    });
  }
</script>
