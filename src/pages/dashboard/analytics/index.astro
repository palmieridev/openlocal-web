---
import { Icon } from "astro-icon/components";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import AnalyticsTabs from "@/components/dashboard/AnalyticsTabs.astro";
import NeedsSetup from "@/components/dashboard/NeedsSetup.astro";
import { getServerAuth } from "@/lib/api/server";
import { authedApi } from "@/lib/api/client";
import { formatPrice } from "@/lib/format";
import { useT } from "@/i18n";
import type { ABCRow } from "@/types/api";

const locale = Astro.locals.locale;
const t = useT(locale).analytics;

const { token, businessId } = await getServerAuth(Astro);

let rows: ABCRow[] = [];
let loadError = false;
if (token && businessId) {
  try {
    rows = await authedApi(token, businessId).abc(100);
  } catch {
    loadError = true;
  }
}

const value = (r: ABCRow) => Number(r.value ?? r.sales_value ?? 0);
const cumulativePercent = (r: ABCRow) => {
  if (r.cumulative_percent != null) return Number(r.cumulative_percent);
  const total = Number(r.total_value ?? 0);
  return total > 0 ? (Number(r.cumulative_value ?? 0) / total) * 100 : null;
};
const max = rows.reduce((m, r) => Math.max(m, value(r)), 0) || 1;
const classStyle: Record<string, string> = {
  A: "bg-accent-soft text-accent",
  B: "bg-warning-soft text-warning",
  C: "bg-surface-secondary text-text-muted",
};
const barColor: Record<string, string> = {
  A: "bg-accent",
  B: "bg-warning",
  C: "bg-text-muted",
};
---

<DashboardLayout active="analitica">
  {!businessId ? (
    <NeedsSetup reason="no-business" />
  ) : loadError ? (
    <NeedsSetup reason="error" />
  ) : (
    <>
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-border bg-surface-card px-8 py-5">
        <h1 class="font-heading text-2xl font-semibold">{t.title}</h1>
      </div>
      <div class="mx-auto max-w-5xl px-8 py-6">
        <AnalyticsTabs active="abc" />

      {rows.length > 0 ? (
        <div class="ol-card mt-6 overflow-hidden">
          <div class="border-b border-border px-5 py-3">
            <h2 class="font-heading font-semibold">{t.abcTitle}</h2>
            <p class="text-xs text-text-muted">{t.abcIntro}</p>
          </div>
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border text-left text-xs uppercase tracking-wide text-text-muted">
                <th class="px-5 py-3 font-medium">{t.colProduct}</th>
                <th class="px-5 py-3 font-medium">{t.colValue}</th>
                <th class="px-5 py-3 font-medium">{t.colCumulative}</th>
                <th class="px-5 py-3 font-medium">{t.colClass}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              {rows.map((r) => {
                const cls = String(r.class ?? r.abc_class ?? "C");
                const cumulative = cumulativePercent(r);
                return (
                  <tr class="hover:bg-surface-primary/50">
                    <td class="px-5 py-3">
                      <div class="font-medium text-text-primary">{r.name ?? r.product_name ?? r.sku ?? r.product_id ?? r.variant_id}</div>
                      <div class="mt-1.5 h-1.5 w-40 overflow-hidden rounded-full bg-surface-secondary">
                        <div class={`h-full ${barColor[cls] ?? barColor.C}`} style={`width:${Math.max(4, (value(r) / max) * 100)}%`}></div>
                      </div>
                    </td>
                    <td class="px-5 py-3 font-data">{formatPrice(value(r), "MXN", locale)}</td>
                    <td class="px-5 py-3 font-data text-text-muted">{cumulative != null ? `${cumulative.toFixed(0)}%` : "—"}</td>
                    <td class="px-5 py-3">
                      <span class={`rounded-full px-2.5 py-1 text-[11px] font-bold ${classStyle[cls] ?? classStyle.C}`}>{cls}</span>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="ol-card mt-6 border-dashed p-12 text-center">
          <Icon name="lucide:chart-column" class="mx-auto text-text-muted" width={32} height={32} />
          <p class="mt-3 text-sm text-text-secondary">{t.abcEmpty}</p>
        </div>
      )}
      </div>
    </>
  )}
</DashboardLayout>
