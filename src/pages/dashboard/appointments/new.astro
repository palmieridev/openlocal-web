---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import RequestForm from "@/components/modules/RequestForm.astro";
import ModuleHeader from "@/components/modules/ModuleHeader.astro";
import ModuleState from "@/components/modules/ModuleState.astro";
import { localePath, useT } from "@/i18n";
import { getServerAuth } from "@/lib/api/server";
import { authedApi } from "@/lib/api/client";
const t = useT(Astro.locals.locale).modules;
const { token, businessId } = await getServerAuth(Astro);
let slug = "";
try {
  if (token && businessId)
    slug = (await authedApi(token, businessId).getBusiness()).slug;
} catch {}
---

<DashboardLayout title={t.newRequest} active="appointments"
  ><main class="module-page module-dashboard">
    <ModuleHeader title={t.newRequest} backHref={localePath(Astro.locals.locale, "/dashboard/appointments")} backLabel={t.appointments} />
    <div class="module-content">{
      slug ? (
        <RequestForm module="appointments" slug={slug} owner />
      ) : (
        <ModuleState />
      )
    }
    </div>
  </main></DashboardLayout
>
