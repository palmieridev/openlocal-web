---
import { Icon } from "astro-icon/components";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import StatTile from "@/components/ui/StatTile.astro";
import NeedsSetup from "@/components/dashboard/NeedsSetup.astro";
import { getServerAuth } from "@/lib/api/server";
import { authedApi } from "@/lib/api/client";
import { localePath, useT } from "@/i18n";
import type { LowStockRow, Product, StockLevel, StockMovement } from "@/types/api";

const locale = Astro.locals.locale;
const t = useT(locale);
const d = t.dashboard;
const to = (href: string) => localePath(locale, href);

const { token, businessId } = await getServerAuth(Astro);

let loadError = false;
let products: Product[] = [];
let levels: StockLevel[] = [];
let low: LowStockRow[] = [];
let movements: StockMovement[] = [];

if (token && businessId) {
  const api = authedApi(token, businessId);
  try {
    [products, levels, low, movements] = await Promise.all([
      api.listProducts(200),
      api.listStockLevels(500),
      api.lowStock(50),
      api.listMovements(8),
    ]);
  } catch {
    loadError = true;
  }
}

const ready = Boolean(token && businessId) && !loadError;

const stats = [
  { label: d.statProducts, value: String(products.length), icon: "lucide:package" },
  { label: d.statStockedSkus, value: String(levels.length), icon: "lucide:boxes" },
  { label: d.statLowStock, value: String(low.length), icon: "lucide:triangle-alert" },
  {
    label: d.statRecentMovements,
    value: String(movements.length),
    icon: "lucide:arrow-left-right",
  },
];

const movementLabel: Record<string, string> = {
  purchase: t.movements.purchase,
  production: t.movements.production,
  sale: t.movements.sale,
  loss: t.movements.loss,
  sample: t.movements.sample,
  adjustment: t.movements.adjustment,
  IN_PURCHASE: t.movements.purchase,
  IN_PRODUCTION: t.movements.production,
  OUT_SALE: t.movements.sale,
  OUT_LOSS: t.movements.loss,
  IN_ADJUSTMENT: t.movements.adjustment,
  OUT_ADJUSTMENT: t.movements.adjustment,
};
const inbound = new Set(["purchase", "production", "IN_PURCHASE", "IN_PRODUCTION", "IN_ADJUSTMENT"]);
---

<DashboardLayout active="inicio">
  {!businessId ? (
    <NeedsSetup reason="no-business" />
  ) : loadError ? (
    <NeedsSetup reason="error" />
  ) : (
    <div class="mx-auto max-w-6xl px-6 py-8">
      <div>
        <h1 class="font-heading text-2xl font-semibold">{d.greeting}</h1>
        <p class="mt-1 text-sm text-text-secondary">{d.summary}</p>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-tour="stats">
        {stats.map((s) => <StatTile label={s.label} value={s.value} icon={s.icon} />)}
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        {/* Recent movements */}
        <div class="ol-card overflow-hidden">
          <div class="flex items-center justify-between border-b border-border px-5 py-3">
            <h2 class="font-heading font-semibold">{d.recentMovements}</h2>
            <a
              href={to("/dashboard/inventory")}
              class="text-sm font-medium text-accent hover:underline"
            >
              {d.seeAll}
            </a>
          </div>
          {movements.length > 0 ? (
            <ul class="divide-y divide-border">
              {movements.map((m) => {
                const isIn = inbound.has(String(m.movement_type));
                return (
                  <li class="flex items-center justify-between px-5 py-3">
                    <span class="flex items-center gap-2 text-sm">
                      <Icon
                        name={isIn ? "lucide:arrow-down-left" : "lucide:arrow-up-right"}
                        class={isIn ? "text-success" : "text-danger"}
                        width={16}
                        height={16}
                      />
                      {movementLabel[String(m.movement_type)] ?? m.movement_type}
                    </span>
                    <span class="font-data text-sm">{isIn ? "+" : "−"}{m.quantity}</span>
                  </li>
                );
              })}
            </ul>
          ) : (
            <p class="px-5 py-8 text-center text-sm text-text-muted">{d.noMovements}</p>
          )}
        </div>

        {/* Low stock */}
        <div class="ol-card overflow-hidden">
          <div class="flex items-center justify-between border-b border-border px-5 py-3">
            <h2 class="font-heading font-semibold">{d.lowStock}</h2>
            <a
              href={to("/dashboard/analytics/low-stock")}
              class="text-sm font-medium text-accent hover:underline"
            >
              {d.seeAll}
            </a>
          </div>
          {low.length > 0 ? (
            <ul class="divide-y divide-border">
              {low.slice(0, 6).map((r) => (
                <li class="flex items-center justify-between px-5 py-3">
                  <span class="truncate text-sm">{r.product_name ?? r.sku ?? r.variant_id}</span>
                  <span class="flex items-center gap-2">
                    <span class="font-data text-sm text-danger">{r.quantity_on_hand}</span>
                    <span class="rounded-full bg-warning-soft px-2 py-0.5 text-[11px] font-semibold text-warning">≤ {r.reorder_point}</span>
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="px-5 py-8 text-center text-sm text-text-muted">{d.allGood}</p>
          )}
        </div>
      </div>
    </div>
  )}
</DashboardLayout>
