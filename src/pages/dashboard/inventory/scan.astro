---
import { Icon } from "astro-icon/components";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import InventoryTabs from "@/components/dashboard/InventoryTabs.astro";
import NeedsSetup from "@/components/dashboard/NeedsSetup.astro";
import Button from "@/components/ui/Button.astro";
import { getServerAuth } from "@/lib/api/server";

const { businessId } = await getServerAuth(Astro);
---

<DashboardLayout active="escaner">
  {!businessId ? (
    <NeedsSetup reason="no-business" />
  ) : (
    <div class="mx-auto max-w-md px-6 py-8" data-business-id={businessId}>
      <h1 class="font-heading text-2xl font-semibold">Escáner</h1>
      <InventoryTabs active="scan" />

      <div class="ol-card mt-6 overflow-hidden">
        <div id="reader" class="aspect-square w-full bg-surface-inverse"></div>
        <div class="flex items-center justify-between gap-2 p-4">
          <Button variant="secondary" size="sm" id="start-btn" icon="lucide:camera">Iniciar cámara</Button>
          <Button variant="ghost" size="sm" id="stop-btn" icon="lucide:square">Detener</Button>
        </div>
      </div>

      {/* Manual fallback */}
      <div class="ol-card mt-4 flex gap-2 p-4">
        <input class="ol-input font-data" id="manual" inputmode="numeric" placeholder="Ingresa el código manualmente" />
        <Button variant="secondary" size="sm" id="manual-btn">Buscar</Button>
      </div>

      {/* Result */}
      <div id="result" class="mt-4 hidden"></div>
    </div>
  )}
</DashboardLayout>

<script>
  import { Html5Qrcode } from "html5-qrcode";

  const root = document.querySelector("[data-business-id]") as HTMLElement | null;
  if (root) {
    const businessId = root.dataset.businessId!;
    const resultEl = document.getElementById("result") as HTMLElement;
    let scanner: Html5Qrcode | null = null;
    let busy = false;

    async function postMovement(variantId: string, type: string, qty: string) {
      const res = await fetch("/api/movements", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ business_id: businessId, variant_id: variantId, movement_type: type, quantity: qty }),
      });
      return res.json().then((d) => ({ ok: res.ok, d }));
    }

    function renderFound(v: any) {
      resultEl.className = "ol-card mt-4 p-5";
      resultEl.innerHTML = `
        <div class="flex items-center gap-2 text-success text-sm font-semibold"><span>✓</span> Producto encontrado</div>
        <div class="mt-2 font-medium">${v.name || v.sku || "Variante"}</div>
        <div class="font-data text-xs text-text-muted">${v.sku || ""}</div>
        <div class="mt-4 flex items-center gap-3">
          <button data-act="out" class="flex-1 rounded-full bg-danger-soft py-2.5 font-semibold text-danger">− Salida</button>
          <input data-qty value="1" inputmode="decimal" class="ol-input font-data w-16 text-center" />
          <button data-act="in" class="flex-1 rounded-full bg-success-soft py-2.5 font-semibold text-success">+ Entrada</button>
        </div>
        <p data-msg class="mt-3 hidden rounded-xl px-3 py-2 text-sm"></p>`;
      resultEl.classList.remove("hidden");
      const qtyEl = resultEl.querySelector("[data-qty]") as HTMLInputElement;
      const msg = resultEl.querySelector("[data-msg]") as HTMLElement;
      resultEl.querySelectorAll("[data-act]").forEach((btn) =>
        btn.addEventListener("click", async () => {
          const act = (btn as HTMLElement).dataset.act;
          const type = act === "in" ? "purchase" : "sale";
          const { ok, d } = await postMovement(v.id, type, qtyEl.value || "1");
          if (ok) {
            msg.className = "mt-3 rounded-xl bg-success-soft px-3 py-2 text-sm text-success";
            msg.textContent = `Stock actual: ${d?.stock_level?.quantity_on_hand ?? "?"}`;
          } else {
            msg.className = "mt-3 rounded-xl bg-danger-soft px-3 py-2 text-sm text-danger";
            msg.textContent = d?.error || "Error al guardar.";
          }
        }),
      );
    }

    function renderNotFound(code: string) {
      resultEl.className = "ol-card mt-4 p-5 text-center";
      resultEl.innerHTML = `
        <div class="text-sm font-semibold text-warning">Código no encontrado</div>
        <div class="font-data mt-1 text-xs text-text-muted">${code}</div>
        <a href="/dashboard/products/new?barcode=${encodeURIComponent(code)}" class="mt-4 inline-flex rounded-full bg-accent px-4 py-2 text-sm font-semibold text-text-inverse">Crear producto con este código</a>`;
      resultEl.classList.remove("hidden");
    }

    async function lookup(code: string) {
      if (busy) return;
      busy = true;
      try {
        const res = await fetch(`/api/lookup?barcode=${encodeURIComponent(code)}&business_id=${businessId}`);
        const data = await res.json();
        if (res.ok) renderFound(data);
        else renderNotFound(code);
      } finally {
        setTimeout(() => (busy = false), 1200);
      }
    }

    document.getElementById("start-btn")?.addEventListener("click", async () => {
      scanner = new Html5Qrcode("reader");
      try {
        await scanner.start(
          { facingMode: "environment" },
          { fps: 10, qrbox: { width: 220, height: 160 } },
          (decoded) => lookup(decoded),
          () => {},
        );
      } catch {
        renderNotFound("Sin acceso a la cámara — usa entrada manual");
      }
    });

    document.getElementById("stop-btn")?.addEventListener("click", async () => {
      if (scanner) { await scanner.stop().catch(() => {}); scanner = null; }
    });

    const manual = document.getElementById("manual") as HTMLInputElement;
    document.getElementById("manual-btn")?.addEventListener("click", () => {
      if (manual.value.trim()) lookup(manual.value.trim());
    });
    manual?.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && manual.value.trim()) lookup(manual.value.trim());
    });
  }
</script>
