---
import { Icon } from "astro-icon/components";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import InventoryTabs from "@/components/dashboard/InventoryTabs.astro";
import NeedsSetup from "@/components/dashboard/NeedsSetup.astro";
import Button from "@/components/ui/Button.astro";
import { getServerAuth } from "@/lib/api/server";
import { authedApi } from "@/lib/api/client";
import type { StockLevel } from "@/types/api";

const { token, businessId } = await getServerAuth(Astro);

let levels: StockLevel[] = [];
let loadError = false;
if (token && businessId) {
  try {
    levels = await authedApi(token, businessId).listStockLevels(500);
  } catch {
    loadError = true;
  }
}

const isLow = (l: StockLevel) =>
  l.reorder_point != null && Number(l.quantity_on_hand) <= Number(l.reorder_point);
---

<DashboardLayout active="inventario">
  {!businessId ? (
    <NeedsSetup reason="no-business" />
  ) : loadError ? (
    <NeedsSetup reason="error" />
  ) : (
    <div class="mx-auto max-w-5xl px-6 py-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="font-heading text-2xl font-semibold">Inventario</h1>
        <div class="flex gap-2">
          <Button variant="secondary" size="sm" icon="lucide:package" href="/dashboard/products">Productos</Button>
          <Button variant="secondary" size="sm" icon="lucide:scan-barcode" href="/dashboard/inventory/scan">Escanear</Button>
          <Button variant="primary" size="sm" icon="lucide:plus" href="/dashboard/products/new">Nuevo producto</Button>
        </div>
      </div>
      <InventoryTabs active="levels" />

      {levels.length > 0 ? (
        <div class="ol-card mt-6 overflow-hidden">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border text-left text-xs uppercase tracking-wide text-text-muted">
                <th class="px-5 py-3 font-medium">Producto / SKU</th>
                <th class="px-5 py-3 text-right font-medium">En mano</th>
                <th class="px-5 py-3 text-right font-medium">Reorden</th>
                <th class="px-5 py-3 font-medium"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              {levels.map((l) => (
                <tr class="hover:bg-surface-primary/50">
                  <td class="px-5 py-3">
                    <div class="font-medium text-text-primary">{l.product_name ?? l.variant_name ?? "—"}</div>
                    {l.sku && <div class="font-data text-xs text-text-muted">{l.sku}</div>}
                  </td>
                  <td class="px-5 py-3 text-right font-data">{l.quantity_on_hand}</td>
                  <td class="px-5 py-3 text-right font-data text-text-muted">{l.reorder_point ?? "—"}</td>
                  <td class="px-5 py-3">
                    {isLow(l) && (
                      <span class="flex items-center gap-1 text-xs font-semibold text-warning">
                        <Icon name="lucide:triangle-alert" width={13} height={13} /> Bajo
                      </span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="ol-card mt-6 border-dashed p-12 text-center">
          <Icon name="lucide:boxes" class="mx-auto text-text-muted" width={32} height={32} />
          <p class="mt-3 text-sm text-text-secondary">Sin existencias registradas. Crea un producto con su variante (SKU) y registra un movimiento para empezar.</p>
          <div class="mt-4 flex justify-center gap-2">
            <Button variant="secondary" size="sm" icon="lucide:package" href="/dashboard/products">Ver productos</Button>
            <Button variant="primary" size="sm" icon="lucide:plus" href="/dashboard/products/new">Nuevo producto</Button>
          </div>
        </div>
      )}
    </div>
  )}
</DashboardLayout>
