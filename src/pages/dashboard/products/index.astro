---
import { Icon } from "astro-icon/components";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import Button from "@/components/ui/Button.astro";
import StatTile from "@/components/ui/StatTile.astro";
import NeedsSetup from "@/components/dashboard/NeedsSetup.astro";
import ScannerModal from "@/components/dashboard/ScannerModal.astro";
import MovementEditModal from "@/components/dashboard/MovementEditModal.astro";
import { getServerAuth } from "@/lib/api/server";
import { authedApi } from "@/lib/api/client";
import { interpolate, localePath, pluralize, useT } from "@/i18n";
import type { Product } from "@/types/api";

const locale = Astro.locals.locale;
const dict = useT(locale);
const t = dict.products;
const product = dict.product;
const to = (href: string) => localePath(locale, href);

const { token, businessId } = await getServerAuth(Astro);

let products: Product[] = [];
let loadError = false;
let skuCount = 0;
let lowStockCount = 0;
if (token && businessId) {
  const api = authedApi(token, businessId);
  // Products is the page; stats are best-effort (don't fail the page on them).
  const [p, sl, ls] = await Promise.allSettled([
    api.listProducts(100),
    api.listStockLevels(100),
    api.lowStock(100),
  ]);
  if (p.status === "fulfilled") products = p.value;
  else loadError = true;
  if (sl.status === "fulfilled") skuCount = sl.value.length;
  if (ls.status === "fulfilled") lowStockCount = ls.value.length;
}

const total = products.length;
const published = products.filter((p) => p.is_public).length;
const pubPct = total ? Math.round((published / total) * 100) : 0;
const activeCount = products.filter((p) => (p.status ?? "") === "active").length;

const statusStyle: Record<string, string> = {
  active: "bg-success-soft text-success",
  draft: "bg-surface-secondary text-text-muted",
  archived: "bg-danger-soft text-danger",
};
const statusLabel: Record<string, string> = {
  active: t.statusActive,
  draft: t.statusDraft,
  archived: t.statusArchived,
};
const typeLabel: Record<string, string> = {
  stocked_product: t.typeStocked,
  made_to_order_product: t.typeMadeToOrder,
  unique_item: t.typeUnique,
};

const tabs = [
  { key: "all", label: t.tabAll },
  { key: "published", label: t.tabPublished },
  { key: "draft", label: t.tabDrafts },
  { key: "made_to_order", label: t.tabMadeToOrder },
  { key: "unique", label: t.tabUnique },
];
---

<DashboardLayout active="productos">
  {!businessId ? (
    <NeedsSetup reason="no-business" />
  ) : loadError ? (
    <NeedsSetup reason="error" />
  ) : (
    <>
      {/* Header */}
      <div class="flex flex-wrap items-start justify-between gap-4 border-b border-border bg-surface-card px-4 py-4 sm:px-8 sm:py-5">
        <div>
          <h1 class="font-heading text-2xl font-semibold">{t.title}</h1>
          <p class="mt-1 text-sm text-text-secondary">{t.subtitle}</p>
        </div>
        <div class="flex items-center gap-2">
          <Button variant="secondary" icon="lucide:scan-barcode" data-open-scanner>{t.scan}</Button>
          <Button
            variant="primary"
            icon="lucide:plus"
            href={to("/dashboard/products/new")}
            data-tour="product-new"
          >
            {t.newProduct}
          </Button>
        </div>
      </div>

      <div class="mx-auto max-w-6xl px-4 py-6 sm:px-8" data-business-id={businessId}>
        {/* Stat tiles */}
        <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        <StatTile
          label={t.statCatalog}
          value={String(total)}
          icon="lucide:package"
          delta={interpolate(t.statActive, { count: activeCount })}
          deltaTone="neutral"
        />
        <StatTile
          label={t.statPublished}
          value={String(published)}
          icon="lucide:eye"
          delta={interpolate(t.statPublishedPct, { pct: pubPct })}
          deltaTone="up"
        />
        <StatTile
          label={t.statSkus}
          value={String(skuCount)}
          icon="lucide:layers"
          delta={t.statWithInventory}
          deltaTone="neutral"
        />
        <StatTile
          label={t.statLowStock}
          value={String(lowStockCount)}
          icon="lucide:triangle-alert"
          delta={t.statNeedReorder}
          deltaTone="down"
        />
      </div>

      {/* Tabs + search */}
      <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
        <nav id="product-tabs" data-tour="product-filters" class="flex flex-wrap gap-1 rounded-full border border-border bg-surface-card p-1 text-sm font-medium">
          {tabs.map((t, i) => (
            <button
              type="button"
              data-filter={t.key}
              class:list={[
                "rounded-full px-4 py-1.5 transition-colors",
                i === 0 ? "bg-surface-secondary text-text-primary" : "text-text-secondary hover:text-text-primary",
              ]}
            >
              {t.label}
            </button>
          ))}
        </nav>
        <div class="flex w-full items-center gap-2 sm:w-auto">
          <div class="relative flex-1 sm:flex-initial">
            <Icon name="lucide:search" class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-text-muted" width={16} height={16} />
            <input
              id="product-search"
              data-tour="product-search"
              type="search"
              placeholder={t.searchPlaceholder}
              class="ol-input w-full rounded-full pl-9 sm:w-64"
            />
          </div>
          <Button variant="secondary" icon="lucide:download" id="export-csv" class="shrink-0">{t.exportCsv}</Button>
        </div>
      </div>

      {products.length > 0 ? (
        <div class="ol-card mt-4 overflow-hidden" data-tour="product-table">
          <div class="flex items-center justify-between border-b border-border px-5 py-4">
            <div>
              <h2 class="font-heading font-semibold">{t.catalogTitle}</h2>
              <p class="text-sm text-text-secondary">
                {pluralize(total, product.countOne, product.countOther)}
              </p>
            </div>
          </div>
          <div class="overflow-x-auto">
          <table class="w-full min-w-[560px] text-sm">
            <thead>
              <tr class="border-b border-border text-left text-xs uppercase tracking-wide text-text-muted">
                <th class="px-5 py-3 font-medium">{t.colProduct}</th>
                <th class="px-5 py-3 font-medium">{t.colType}</th>
                <th class="px-5 py-3 font-medium">{t.colStatus}</th>
                <th class="px-5 py-3 font-medium">{t.colPublic}</th>
                <th class="px-5 py-3"></th>
              </tr>
            </thead>
            <tbody id="product-rows" class="divide-y divide-border">
              {products.map((p) => (
                <tr
                  class="product-row hover:bg-surface-primary/50"
                  data-name={`${p.name} ${p.brand ?? ""} ${p.slug}`.toLowerCase()}
                  data-public={p.is_public ? "1" : "0"}
                  data-status={p.status ?? "draft"}
                  data-type={p.product_type}
                >
                  <td class="px-5 py-3">
                    <div class="font-medium text-text-primary">{p.name}</div>
                    <div class="mt-0.5 flex items-center gap-2 text-xs text-text-muted">
                      {p.brand && <span>{p.brand}</span>}
                      {p.is_handmade && <span class="text-accent">{t.handmade}</span>}
                    </div>
                  </td>
                  <td class="px-5 py-3 text-text-secondary">{typeLabel[p.product_type] ?? p.product_type}</td>
                  <td class="px-5 py-3">
                    <span class={`rounded-full px-2.5 py-1 text-[11px] font-semibold ${statusStyle[p.status ?? "draft"] ?? statusStyle.draft}`}>
                      {statusLabel[p.status ?? "draft"] ?? t.statusDraft}
                    </span>
                  </td>
                  <td class="px-5 py-3">
                    <Icon
                      name={p.is_public ? "lucide:eye" : "lucide:eye-off"}
                      class={p.is_public ? "text-success" : "text-text-muted"}
                      width={16}
                      height={16}
                    />
                  </td>
                  <td class="px-5 py-3 text-right">
                    <a
                      href={to(`/dashboard/products/${p.id}`)}
                      class="text-sm font-medium text-accent hover:underline"
                    >
                      {t.edit}
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          </div>
          <p id="no-results" class="hidden px-5 py-10 text-center text-sm text-text-muted">
            {t.noSearchResults}
          </p>
        </div>
      ) : (
        <div class="ol-card mt-4 border-dashed p-12 text-center">
          <Icon name="lucide:package" class="mx-auto text-text-muted" width={32} height={32} />
          <p class="mt-3 text-sm text-text-secondary">{t.empty}</p>
          <Button variant="primary" size="sm" href={to("/dashboard/products/new")} class="mt-4">
            {t.createFirst}
          </Button>
        </div>
      )}
      </div>

      <ScannerModal />
      <MovementEditModal businessId={businessId} />
    </>
  )}
</DashboardLayout>

<script>
  import { ui } from "@/lib/i18n-client";

  const t = ui().products;
  const tabsEl = document.getElementById("product-tabs");
  const searchEl = document.getElementById("product-search") as HTMLInputElement | null;
  const rows = Array.from(document.querySelectorAll<HTMLElement>(".product-row"));
  const noResults = document.getElementById("no-results");

  let activeFilter = "all";

  function matchesTab(row: HTMLElement): boolean {
    switch (activeFilter) {
      case "published":
        return row.dataset.public === "1";
      case "draft":
        return row.dataset.status === "draft";
      case "made_to_order":
        return (row.dataset.type ?? "").includes("made_to_order");
      case "unique":
        return (row.dataset.type ?? "").includes("unique");
      default:
        return true;
    }
  }

  function apply() {
    const q = (searchEl?.value ?? "").trim().toLowerCase();
    let shown = 0;
    for (const row of rows) {
      const ok = matchesTab(row) && (!q || (row.dataset.name ?? "").includes(q));
      row.classList.toggle("hidden", !ok);
      if (ok) shown++;
    }
    noResults?.classList.toggle("hidden", shown !== 0);
  }

  tabsEl?.querySelectorAll<HTMLButtonElement>("button[data-filter]").forEach((btn) => {
    btn.addEventListener("click", () => {
      activeFilter = btn.dataset.filter ?? "all";
      tabsEl.querySelectorAll<HTMLButtonElement>("button[data-filter]").forEach((b) => {
        const on = b === btn;
        b.classList.toggle("bg-surface-secondary", on);
        b.classList.toggle("text-text-primary", on);
        b.classList.toggle("text-text-secondary", !on);
      });
      apply();
    });
  });

  searchEl?.addEventListener("input", apply);

  document.getElementById("export-csv")?.addEventListener("click", () => {
    const header = [t.colProduct, t.csvBrand, t.colType, t.colStatus, t.colPublic];
    const lines = [header.join(",")];
    for (const row of rows) {
      const cells = row.querySelectorAll("td");
      const name = (cells[0]?.querySelector(".font-medium")?.textContent ?? "").trim();
      const brand = row.dataset.name?.split(" ")[1] ?? "";
      const type = (cells[1]?.textContent ?? "").trim();
      const status = (cells[2]?.textContent ?? "").trim();
      const pub = row.dataset.public === "1" ? t.csvYes : t.csvNo;
      const esc = (s: string) => `"${s.replace(/"/g, '""')}"`;
      lines.push([name, brand, type, status, pub].map(esc).join(","));
    }
    const blob = new Blob(["﻿" + lines.join("\n")], { type: "text/csv;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = t.csvFilename;
    a.click();
    URL.revokeObjectURL(url);
  });
</script>
