---
import { Icon } from "astro-icon/components";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import Button from "@/components/ui/Button.astro";
import ProductCard from "@/components/ui/ProductCard.astro";
import NeedsSetup from "@/components/dashboard/NeedsSetup.astro";
import { getServerAuth } from "@/lib/api/server";
import { authedApi } from "@/lib/api/client";
import { formatPrice, stockMeta } from "@/lib/format";
import type { Business, Product, Variant } from "@/types/api";

const { id } = Astro.params;
const { token, businessId } = await getServerAuth(Astro);

let product: Product | null = null;
let business: Business | null = null;
let loadError = false;
let variants: Variant[] = [];
if (token && businessId && id) {
  const api = authedApi(token, businessId);
  try {
    product = await api.getProduct(id);
  } catch {
    loadError = true;
  }
  // Business is best-effort: powers the storefront link + preview brand line.
  try {
    business = await api.getBusiness();
  } catch {
    /* tolerate */
  }
  if (product) {
    try {
      variants = await api.listProductVariants(product.id);
    } catch {
      /* tolerate; the product editor can still render */
    }
  }
}

const firstVariant = variants[0];

const productTypes = [
  ["stocked_product", "Producto con inventario"],
  ["made_to_order_product", "Bajo pedido"],
  ["unique_item", "Pieza única"],
];

const stockStatuses = [
  ["available", "En stock"],
  ["low_stock", "Pocas piezas"],
  ["out_of_stock", "Agotado"],
  ["made_to_order", "Bajo pedido"],
  ["unknown", "Consultar"],
];

const previewMeta = product
  ? [business?.name, product.brand, product.description].filter(Boolean).join(" · ")
  : "";
---

<DashboardLayout active="productos">
  {!businessId ? (
    <NeedsSetup reason="no-business" />
  ) : loadError || !product ? (
    <NeedsSetup reason="error" />
  ) : (
    <>
      {/* Action bar */}
      <div class="flex flex-wrap items-start justify-between gap-4 border-b border-border bg-surface-card px-4 py-4 sm:px-8 sm:py-5">
        <div>
          <h1 class="font-heading text-2xl font-semibold">Editar producto</h1>
          <p class="mt-1 text-sm text-text-secondary">
            {product.name}{business?.name && <> · {business.name}</>}
          </p>
        </div>
        <div class="flex items-center gap-2">
          {business?.slug && (
            <Button variant="secondary" icon="lucide:external-link" href={`/business/${business.slug}`}>Ver en tienda</Button>
          )}
          <Button variant="primary" icon="lucide:check" type="submit" form="edit-form">Guardar cambios</Button>
        </div>
      </div>

      <div class="mx-auto max-w-6xl px-4 py-6 sm:px-8" data-business-id={businessId} data-product-id={product.id}>
        <a href="/dashboard/products" class="inline-flex items-center gap-1.5 text-sm text-text-muted hover:text-text-secondary">
          <Icon name="lucide:arrow-left" width={15} height={15} /> Productos
        </a>

      <div class="mt-4 grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
        {/* Left column */}
        <div class="flex min-w-0 flex-col gap-6">
          {/* Details */}
          <form id="edit-form" class="ol-card flex flex-col gap-4 p-6">
            <div>
              <h2 class="font-heading font-semibold">Detalles del producto</h2>
              <p class="text-sm text-text-secondary">Lo que verán los compradores en tu tienda.</p>
            </div>
            <div>
              <label class="ol-label" for="name">Nombre</label>
              <input class="ol-input" id="name" name="name" value={product.name} required />
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
              <div>
                <label class="ol-label" for="brand">Marca</label>
                <input class="ol-input" id="brand" name="brand" value={product.brand ?? ""} placeholder="Sin marca" />
              </div>
              <div>
                <label class="ol-label" for="product_type">Tipo</label>
                <select class="ol-select" id="product_type" name="product_type">
                  {productTypes.map(([v, l]) => (
                    <option value={v} selected={v === product.product_type}>{l}</option>
                  ))}
                </select>
              </div>
            </div>
            <div>
              <label class="ol-label" for="description">Descripción</label>
              <textarea class="ol-textarea" id="description" name="description" rows="3">{product.description}</textarea>
            </div>
            <div class="flex gap-6 border-t border-border pt-4">
              <label class="flex items-center gap-2 text-sm text-text-secondary">
                <input type="checkbox" name="is_handmade" checked={product.is_handmade} /> Hecho a mano
              </label>
              <label class="flex items-center gap-2 text-sm text-text-secondary">
                <input type="checkbox" name="is_public" checked={product.is_public} /> Visible en tienda
              </label>
            </div>
            <p id="edit-msg" class="hidden rounded-xl px-3 py-2 text-sm"></p>
            <div class="flex justify-center border-t border-border pt-5">
              <Button type="submit" variant="primary" id="edit-btn" class="w-full max-w-80"><span data-label>Guardar cambios</span></Button>
            </div>
          </form>

          {/* Variants list */}
          <div class="ol-card p-6">
            <h2 class="font-heading font-semibold">Variantes</h2>
            <p class="mt-1 text-sm text-text-secondary">SKU, precio y stock público. Una variante visible basta para que el producto aparezca en tu tienda.</p>
            {variants.length > 0 ? (
              <div class="mt-4 overflow-hidden rounded-xl border border-border">
                <div class="overflow-x-auto">
                <table class="w-full min-w-[480px] text-sm">
                  <thead>
                    <tr class="border-b border-border text-left text-[11px] uppercase tracking-wide text-text-muted">
                      <th class="px-4 py-2.5 font-medium">Variante / SKU</th>
                      <th class="px-4 py-2.5 font-medium">Precio</th>
                      <th class="px-4 py-2.5 font-medium">Stock público</th>
                      <th class="px-4 py-2.5 font-medium"><span class="sr-only">Editar</span></th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-border">
                    {variants.map((v) => {
                      const sm = stockMeta(v.public_stock_status);
                      return (
                        <tr>
                          <td class="px-4 py-3">
                            <div class="font-medium text-text-primary">{v.name || product.name}</div>
                            <div class="font-data text-xs text-text-muted">{v.sku}</div>
                            {v.track_inventory === false && (
                              <div class="mt-0.5 inline-flex items-center gap-1 text-[11px] text-text-muted">
                                <Icon name="lucide:eye-off" width={11} height={11} /> Sin seguimiento de inventario
                              </div>
                            )}
                          </td>
                          <td class="px-4 py-3 font-data">{formatPrice(v.price, v.currency)}</td>
                          <td class="px-4 py-3">
                            <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-semibold ${sm.bg} ${sm.fg}`}>
                              <span class={`size-1.5 rounded-full ${sm.dot}`}></span>{sm.label}
                            </span>
                          </td>
                          <td class="px-4 py-3 text-right">
                            <button
                              type="button"
                              class="variant-edit inline-flex size-8 items-center justify-center rounded-lg border border-border text-text-secondary hover:bg-surface-secondary"
                              data-variant={JSON.stringify(v)}
                              aria-label="Editar variante"
                            >
                              <Icon name="lucide:square-pen" width={15} height={15} />
                            </button>
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
                </div>
              </div>
            ) : (
              <div class="mt-4 rounded-xl border border-dashed border-border px-4 py-8 text-center">
                <Icon name="lucide:tags" class="mx-auto text-text-muted" width={24} height={24} />
                <p class="mt-2 text-sm text-text-secondary">Aún no hay variantes para este producto.</p>
              </div>
            )}
            <div class="mt-5 flex justify-center border-t border-border pt-5">
              <Button variant="secondary" id="variant-add-btn" icon="lucide:plus" class="w-full max-w-80">Agregar variante</Button>
            </div>
          </div>
        </div>

        {/* Right column */}
        <div class="flex min-w-0 flex-col gap-6">
          {/* Storefront preview */}
          <div class="ol-card p-5">
            <div class="mb-4 flex items-start justify-between">
              <div>
                <h2 class="font-heading font-semibold">Vista en tienda</h2>
                <p class="text-sm text-text-secondary">Así te ven los compradores</p>
              </div>
              <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-semibold ${product.is_public ? "bg-success-soft text-success" : "bg-surface-secondary text-text-muted"}`}>
                <Icon name={product.is_public ? "lucide:eye" : "lucide:eye-off"} width={12} height={12} />
                {product.is_public ? "Público" : "Oculto"}
              </span>
            </div>
            <ProductCard
              name={product.name}
              meta={previewMeta}
              price={firstVariant?.price ?? ""}
              currency={firstVariant?.currency ?? "MXN"}
              stockStatus={firstVariant?.public_stock_status}
            />
          </div>

          {/* Store ≠ inventory note */}
          <div class="rounded-2xl border border-border bg-accent-soft/60 p-4">
            <div class="flex items-center gap-2">
              <Icon name="lucide:info" class="text-accent" width={16} height={16} />
              <h3 class="font-heading text-sm font-semibold">Tienda ≠ inventario</h3>
            </div>
            <p class="mt-2 text-[13px] leading-relaxed text-text-secondary">
              Aparece en tu tienda cuando está «Visible en tienda» y tiene una variante. Eso no registra inventario:
              el estado de stock público es una etiqueta manual. Para controlar existencias y recibir alertas, registra
              un movimiento de stock.
            </p>
          </div>
        </div>
      </div>

      {/* Variant add/edit modal — shared popup */}
      <div id="variant-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
        <form id="variant-form" class="ol-card flex w-full max-w-md flex-col gap-4 p-6 shadow-xl">
          <input type="hidden" name="variant_id" />
          <div class="flex items-center justify-between">
            <h2 id="variant-modal-title" class="font-heading font-semibold">Agregar variante</h2>
            <button type="button" id="variant-modal-close" class="text-text-muted hover:text-text-secondary" aria-label="Cerrar">
              <Icon name="lucide:x" width={18} height={18} />
            </button>
          </div>
          <div>
            <label class="ol-label" for="vname">Nombre de la variante</label>
            <input class="ol-input" id="vname" name="vname" placeholder="Color natural" />
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label class="ol-label" for="sku">SKU *</label>
              <input class="ol-input" id="sku" name="sku" required placeholder="BOLSA-001" />
            </div>
            <div>
              <label class="ol-label" for="barcode">Código de barras</label>
              <input class="ol-input" id="barcode" name="barcode" placeholder="7501234567890" />
            </div>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label class="ol-label" for="price">Precio (MXN) *</label>
              <input class="ol-input font-data" id="price" name="price" inputmode="decimal" required placeholder="420.00" />
            </div>
            <div>
              <label class="ol-label" for="cost">Costo</label>
              <input class="ol-input font-data" id="cost" name="cost" inputmode="decimal" placeholder="0.00" />
            </div>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label class="ol-label" for="reorder_point">Punto reorden</label>
              <input class="ol-input font-data" id="reorder_point" name="reorder_point" inputmode="decimal" placeholder="5" />
            </div>
            <div>
              <label class="ol-label" for="public_stock_status">Estado de stock público</label>
              <select class="ol-select" id="public_stock_status" name="public_stock_status">
                {stockStatuses.map(([v, l]) => <option value={v}>{l}</option>)}
              </select>
            </div>
          </div>
          <label class="flex items-center gap-2 text-sm text-text-secondary">
            <input type="checkbox" name="track_inventory" checked /> Controlar inventario
          </label>
          <p id="variant-msg" class="hidden rounded-xl px-3 py-2 text-sm"></p>
          <div class="flex items-center justify-between border-t border-border pt-4">
            <button type="button" id="variant-delete" class="hidden text-sm font-medium text-danger hover:underline">Eliminar variante</button>
            <div class="ml-auto flex items-center gap-2">
              <Button type="button" variant="secondary" id="variant-cancel">Cancelar</Button>
              <Button type="submit" variant="primary" id="variant-btn"><span data-label>Guardar</span></Button>
            </div>
          </div>
        </form>
      </div>
      </div>
    </>
  )}
</DashboardLayout>

<script>
  const root = document.querySelector("[data-product-id]") as HTMLElement | null;
  if (root) {
    const businessId = root.dataset.businessId!;
    const productId = root.dataset.productId!;

    function flash(el: HTMLElement, ok: boolean, msg: string) {
      el.textContent = msg;
      el.className = `rounded-xl px-3 py-2 text-sm ${ok ? "bg-success-soft text-success" : "bg-danger-soft text-danger"}`;
    }

    const editForm = document.getElementById("edit-form") as HTMLFormElement;
    const editMsg = document.getElementById("edit-msg") as HTMLElement;
    editForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(editForm);
      const payload = {
        business_id: businessId,
        name: String(fd.get("name") || ""),
        brand: String(fd.get("brand") || ""),
        product_type: String(fd.get("product_type") || ""),
        description: String(fd.get("description") || ""),
        is_handmade: fd.get("is_handmade") === "on",
        is_public: fd.get("is_public") === "on",
        status: "active",
      };
      const res = await fetch(`/api/products/${productId}`, {
        method: "PATCH",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      flash(editMsg, res.ok, res.ok ? "Cambios guardados." : data?.error || "Error al guardar.");
    });

    // --- Variant add/edit modal (shared popup) ---
    const modal = document.getElementById("variant-modal") as HTMLElement;
    const vForm = document.getElementById("variant-form") as HTMLFormElement;
    const vMsg = document.getElementById("variant-msg") as HTMLElement;
    const vTitle = document.getElementById("variant-modal-title") as HTMLElement;
    const vBtnLabel = vForm?.querySelector("#variant-btn [data-label]") as HTMLElement;
    const deleteBtn = document.getElementById("variant-delete") as HTMLButtonElement;
    const set = (name: string, value: string) => {
      const el = vForm.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
      if (el) el.value = value;
    };

    function openModal(variant?: Record<string, any>) {
      vMsg.className = "hidden";
      vForm.reset();
      if (variant) {
        vTitle.textContent = "Editar variante";
        vBtnLabel.textContent = "Guardar cambios";
        deleteBtn.classList.remove("hidden");
        set("variant_id", variant.id ?? "");
        set("vname", variant.name ?? "");
        set("sku", variant.sku ?? "");
        set("barcode", variant.barcode ?? "");
        set("price", variant.price ?? "");
        set("cost", variant.cost ?? "");
        set("reorder_point", variant.reorder_point ?? "");
        set("public_stock_status", variant.public_stock_status ?? "unknown");
        (vForm.elements.namedItem("track_inventory") as HTMLInputElement).checked =
          variant.track_inventory !== false;
      } else {
        vTitle.textContent = "Agregar variante";
        vBtnLabel.textContent = "Guardar";
        deleteBtn.classList.add("hidden");
        set("variant_id", "");
      }
      modal.classList.remove("hidden");
      modal.classList.add("flex");
    }
    function closeModal() {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }

    document.getElementById("variant-add-btn")?.addEventListener("click", () => openModal());
    document.querySelectorAll<HTMLElement>(".variant-edit").forEach((btn) => {
      btn.addEventListener("click", () => {
        try {
          openModal(JSON.parse(btn.dataset.variant || "{}"));
        } catch {
          openModal();
        }
      });
    });
    document.getElementById("variant-cancel")?.addEventListener("click", closeModal);
    document.getElementById("variant-modal-close")?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    vForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(vForm);
      const str = (k: string) => String(fd.get(k) || "").trim();
      const variantId = str("variant_id");
      const sku = str("sku");
      // Only send optional fields when filled — the API parses cost/barcode/etc.
      // strictly and 500s on an empty decimal string.
      const payload: Record<string, unknown> = {
        business_id: businessId,
        product_id: productId,
        sku,
        name: str("vname") || sku,
        attributes: {},
        price: str("price") || "0",
        public_stock_status: str("public_stock_status") || "unknown",
        track_inventory: fd.get("track_inventory") === "on",
        currency: "MXN",
        status: "active",
      };
      const barcode = str("barcode");
      if (barcode) payload.barcode = barcode;
      const cost = str("cost");
      if (cost) payload.cost = cost;
      const reorder = str("reorder_point");
      if (reorder) payload.reorder_point = reorder;

      const res = await fetch(variantId ? `/api/variants/${variantId}` : "/api/variants", {
        method: variantId ? "PATCH" : "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (res.ok) {
        flash(vMsg, true, variantId ? "Variante actualizada." : "Variante agregada.");
        window.setTimeout(() => window.location.reload(), 350);
      } else {
        flash(vMsg, false, data?.error || "Error al guardar variante.");
      }
    });

    deleteBtn?.addEventListener("click", async () => {
      const variantId = String(
        (vForm.elements.namedItem("variant_id") as HTMLInputElement).value || "",
      );
      if (!variantId || !window.confirm("¿Archivar esta variante?")) return;
      const res = await fetch(
        `/api/variants/${variantId}?business_id=${encodeURIComponent(businessId)}`,
        { method: "DELETE" },
      );
      const data = await res.json().catch(() => ({}));
      if (res.ok) {
        flash(vMsg, true, "Variante archivada.");
        window.setTimeout(() => window.location.reload(), 350);
      } else {
        flash(vMsg, false, data?.error || "Error al archivar variante.");
      }
    });
  }
</script>
