---
import { Icon } from "astro-icon/components";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import Button from "@/components/ui/Button.astro";
import ProductCard from "@/components/ui/ProductCard.astro";
import NeedsSetup from "@/components/dashboard/NeedsSetup.astro";
import ImageUploader from "@/components/dashboard/ImageUploader.astro";
import { getServerAuth } from "@/lib/api/server";
import { authedApi } from "@/lib/api/client";
import { formatPrice, stockMeta } from "@/lib/format";
import {
  VARIANT_DESCRIPTION_MAX,
  VARIANT_PRICE_NOTE_MAX,
  isVariantVisible,
  variantIsPublic,
  variantPriceNote,
  variantVisibility,
} from "@/lib/variants";
import { interpolate, localePath, useT } from "@/i18n";
import type { Business, Product, Variant } from "@/types/api";

const locale = Astro.locals.locale;
const dict = useT(locale);
const t = dict.productDetail;
const prod = dict.products;
const to = (href: string) => localePath(locale, href);

const { id } = Astro.params;
const { token, businessId } = await getServerAuth(Astro);

let product: Product | null = null;
let business: Business | null = null;
let loadError = false;
let variants: Variant[] = [];
if (token && businessId && id) {
  const api = authedApi(token, businessId);
  try {
    product = await api.getProduct(id);
  } catch {
    loadError = true;
  }
  // Business is best-effort: powers the storefront link + preview brand line.
  try {
    business = await api.getBusiness();
  } catch {
    /* tolerate */
  }
  if (product) {
    try {
      variants = await api.listProductVariants(product.id);
    } catch {
      /* tolerate; the product editor can still render */
    }
  }
}

/**
 * The preview mirrors the storefront, so it shows the first card that actually
 * reaches it (product switch AND variant switch). With nothing visible it falls
 * back to the first variant, and the badge says the product is hidden.
 */
const visibility = variantVisibility(product, variants);
const productVisible = visibility.visible > 0;
const previewVariant = variants.find((v) => isVariantVisible(product, v)) ?? variants[0];

const productTypes = [
  ["stocked_product", prod.typeStockedLong],
  ["made_to_order_product", prod.typeMadeToOrder],
  ["unique_item", prod.typeUnique],
];

const stockStatuses = [
  ["available", dict.stock.inStock],
  ["low_stock", dict.stock.lowStock],
  ["out_of_stock", dict.stock.outOfStock],
  ["made_to_order", dict.stock.madeToOrder],
  ["unknown", dict.stock.unknown],
];

const previewMeta = product
  ? [business?.name, product.brand, product.description].filter(Boolean).join(" · ")
  : "";
---

<DashboardLayout active="productos">
  {!businessId ? (
    <NeedsSetup reason="no-business" />
  ) : loadError || !product ? (
    <NeedsSetup reason="error" />
  ) : (
    <>
      {/* Action bar */}
      <div class="flex flex-wrap items-start justify-between gap-4 border-b border-border bg-surface-card px-4 py-4 sm:px-8 sm:py-5">
        <div>
          <h1 class="font-heading text-2xl font-semibold">{t.heading}</h1>
          <p class="mt-1 text-sm text-text-secondary">
            {product.name}{business?.name && <> · {business.name}</>}
          </p>
        </div>
        <div class="flex items-center gap-2">
          {business?.slug && (
            <Button
              variant="secondary"
              icon="lucide:external-link"
              href={to(`/business/${business.slug}`)}
            >
              {t.viewInShop}
            </Button>
          )}
          <Button variant="primary" icon="lucide:check" type="submit" form="edit-form">
            {t.saveChanges}
          </Button>
        </div>
      </div>

      <div class="mx-auto max-w-6xl px-4 py-6 sm:px-8" data-business-id={businessId} data-product-id={product.id}>
        <a
          href={to("/dashboard/products")}
          class="inline-flex items-center gap-1.5 text-sm text-text-muted hover:text-text-secondary"
        >
          <Icon name="lucide:arrow-left" width={15} height={15} /> {prod.title}
        </a>

      <div class="mt-4 grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
        {/* Left column */}
        <div class="flex min-w-0 flex-col gap-6">
          {/* Details */}
          <form id="edit-form" class="ol-card flex flex-col gap-4 p-6">
            <div>
              <h2 class="font-heading font-semibold">{prod.detailsTitle}</h2>
              <p class="text-sm text-text-secondary">{prod.detailsIntro}</p>
            </div>
            <div>
              <label class="ol-label" for="name">{t.name}</label>
              <input class="ol-input" id="name" name="name" value={product.name} required />
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
              <div>
                <label class="ol-label" for="brand">{prod.brand}</label>
                <input
                  class="ol-input"
                  id="brand"
                  name="brand"
                  value={product.brand ?? ""}
                  placeholder={t.noBrand}
                />
              </div>
              <div>
                <label class="ol-label" for="product_type">{prod.type}</label>
                <select class="ol-select" id="product_type" name="product_type">
                  {productTypes.map(([v, l]) => (
                    <option value={v} selected={v === product.product_type}>{l}</option>
                  ))}
                </select>
              </div>
            </div>
            <div>
              <label class="ol-label" for="description">{prod.description}</label>
              <textarea class="ol-textarea" id="description" name="description" rows="3">{product.description}</textarea>
            </div>
            <div class="border-t border-border pt-4">
              <div class="flex gap-6">
                <label class="flex items-center gap-2 text-sm text-text-secondary">
                  <input type="checkbox" name="is_handmade" checked={product.is_handmade} /> {prod.isHandmade}
                </label>
                <label class="flex items-center gap-2 text-sm text-text-secondary">
                  <input type="checkbox" name="is_public" checked={product.is_public} /> {prod.isPublic}
                </label>
              </div>
              <p class="mt-2 text-xs text-text-muted">{prod.isPublicHint}</p>
            </div>
            <p id="edit-msg" class="hidden rounded-xl px-3 py-2 text-sm"></p>
            <div class="flex justify-center border-t border-border pt-5">
              <Button type="submit" variant="primary" id="edit-btn" class="w-full max-w-80">
                <span data-label>{t.saveChanges}</span>
              </Button>
            </div>
          </form>

          {/* Variants — horizontal card carousel */}
          <div class="ol-card p-6">
            <h2 class="font-heading font-semibold">{t.variants}</h2>
            <p class="mt-1 text-sm text-text-secondary">{t.variantsIntro}</p>
            {variants.length > 0 ? (
              /* Scroll-snap rail: cards keep a fixed width so several peek in
                 on desktop while staying swipeable on a phone. */
              <div class="-mx-6 mt-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-2">
                {variants.map((v) => {
                  const sm = stockMeta(v.public_stock_status, locale);
                  const hidden = !variantIsPublic(v);
                  return (
                    <article class={`flex w-56 shrink-0 snap-start flex-col overflow-hidden rounded-xl border bg-surface-card ${hidden ? "border-dashed border-border opacity-70" : "border-border"}`}>
                      {/* object-contain: variant photos are stored uncropped,
                          so a portrait shot has to be shown whole. */}
                      <div class="relative flex h-32 items-start justify-end bg-accent-soft p-2">
                        {v.image_url ? (
                          <img
                            src={v.image_url}
                            alt=""
                            loading="lazy"
                            decoding="async"
                            class="absolute inset-0 size-full object-contain"
                          />
                        ) : (
                          <Icon name="lucide:image" class="absolute inset-0 m-auto text-accent/30" width={28} height={28} />
                        )}
                        <span class={`relative z-10 inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-[10px] font-semibold ${sm.bg} ${sm.fg}`}>
                          <span class={`size-1.5 rounded-full ${sm.dot}`}></span>{sm.label}
                        </span>
                      </div>
                      <div class="flex flex-1 flex-col gap-1 p-3">
                        <p class="truncate text-sm font-medium text-text-primary">{v.name || product.name}</p>
                        {hidden && (
                          <span class="inline-flex w-fit items-center gap-1 rounded-full bg-surface-secondary px-2 py-0.5 text-[10px] font-semibold text-text-muted">
                            <Icon name="lucide:eye-off" width={11} height={11} /> {t.variantHidden}
                          </span>
                        )}
                        <p class="font-data text-xs text-text-muted">{v.sku}</p>
                        <p class="font-data text-base font-semibold text-text-primary">
                          {formatPrice(v.price, v.currency, locale)}
                        </p>
                        {v.track_inventory === false && (
                          <span class="inline-flex items-center gap-1 text-[11px] text-text-muted">
                            <Icon name="lucide:eye-off" width={11} height={11} /> {t.noInventory}
                          </span>
                        )}
                        <button
                          type="button"
                          class="variant-edit mt-2 inline-flex items-center justify-center gap-1.5 rounded-lg border border-border px-3 py-1.5 text-xs font-medium text-text-secondary hover:bg-surface-secondary"
                          data-variant={JSON.stringify(v)}
                        >
                          <Icon name="lucide:square-pen" width={13} height={13} /> {prod.edit}
                        </button>
                      </div>
                    </article>
                  );
                })}
              </div>
            ) : (
              <div class="mt-4 rounded-xl border border-dashed border-border px-4 py-8 text-center">
                <Icon name="lucide:tags" class="mx-auto text-text-muted" width={24} height={24} />
                <p class="mt-2 text-sm text-text-secondary">{t.noVariants}</p>
              </div>
            )}
            <div class="mt-5 flex justify-center border-t border-border pt-5">
              <Button variant="secondary" id="variant-add-btn" icon="lucide:plus" class="w-full max-w-80">
                {t.addVariant}
              </Button>
            </div>
          </div>
        </div>

        {/* Right column */}
        <div class="flex min-w-0 flex-col gap-6">
          {/* Storefront preview */}
          <div class="ol-card p-5">
            <div class="mb-4 flex items-start justify-between">
              <div>
                <h2 class="font-heading font-semibold">{prod.previewTitle}</h2>
                <p class="text-sm text-text-secondary">{prod.previewIntro}</p>
              </div>
              <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-semibold ${productVisible ? "bg-success-soft text-success" : "bg-surface-secondary text-text-muted"}`}>
                <Icon name={productVisible ? "lucide:eye" : "lucide:eye-off"} width={12} height={12} />
                {productVisible ? t.public : t.hidden}
              </span>
            </div>
            <div id="preview-card">
            <ProductCard
              name={product.name}
              meta={previewMeta}
              price={previewVariant?.price ?? ""}
              currency={previewVariant?.currency ?? "MXN"}
              priceNote={variantPriceNote(previewVariant)}
              stockStatus={previewVariant?.public_stock_status}
              imageUrl={previewVariant?.image_url}
            />
            </div>
            <p class="mt-3 text-xs text-text-muted">
              {visibility.total === 0
                ? t.previewNoVariants
                : interpolate(t.previewVisibleCount, {
                    visible: visibility.visible,
                    total: visibility.total,
                  })}
            </p>
          </div>

          {/* Store ≠ inventory note */}
          <div class="rounded-2xl border border-border bg-accent-soft/60 p-4">
            <div class="flex items-center gap-2">
              <Icon name="lucide:info" class="text-accent" width={16} height={16} />
              <h3 class="font-heading text-sm font-semibold">{t.storeVsInventory}</h3>
            </div>
            <p class="mt-2 text-[13px] leading-relaxed text-text-secondary">
              {t.storeVsInventoryBody}
            </p>
          </div>
        </div>
      </div>

      {/* Variant add/edit modal — shared popup.
          The overlay scrolls (items-start + my-auto on the panel) instead of
          centring a panel taller than the viewport: on a phone the form is
          longer than the screen, and centring it clipped Guardar/Cancelar off
          both ends with no way to reach them. */}
      <div id="variant-modal" class="fixed inset-0 z-50 hidden items-start justify-center overflow-y-auto overscroll-contain bg-black/40 p-4">
        <form id="variant-form" class="ol-card my-auto flex w-full max-w-md flex-col gap-4 p-6 shadow-xl">
          <input type="hidden" name="variant_id" />
          <div class="flex items-center justify-between">
            <h2 id="variant-modal-title" class="font-heading font-semibold">{t.addVariant}</h2>
            <button
              type="button"
              id="variant-modal-close"
              class="text-text-muted hover:text-text-secondary"
              aria-label={dict.common.close}
            >
              <Icon name="lucide:x" width={18} height={18} />
            </button>
          </div>
          <div>
            <span class="ol-label">{t.image}</span>
            {/* One shared control for the modal; openModal() loads the selected
                variant's URL into it via the "image-set" event. */}
            <ImageUploader
              id="variant-image"
              kind="product"
              crop={false}
              heightClass="h-48"
              hint={t.imageHint}
            />
          </div>
          <div>
            <label class="ol-label" for="vname">{t.variantName}</label>
            <input class="ol-input" id="vname" name="vname" placeholder={t.variantNamePlaceholder} />
          </div>
          <div>
            <label class="ol-label" for="vdescription">{t.variantDescription}</label>
            <textarea
              class="ol-textarea"
              id="vdescription"
              name="vdescription"
              rows="3"
              maxlength={VARIANT_DESCRIPTION_MAX}
              aria-describedby="vdescription-hint"
              placeholder={t.variantDescriptionPlaceholder}></textarea>
            <p id="vdescription-hint" class="mt-1 text-xs text-text-muted">
              {t.variantDescriptionHint}
            </p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label class="ol-label" for="sku">{t.sku}</label>
              <input class="ol-input" id="sku" name="sku" required placeholder="BOLSA-001" />
            </div>
            <div>
              <label class="ol-label" for="barcode">{t.barcode}</label>
              <input class="ol-input" id="barcode" name="barcode" placeholder="7501234567890" />
            </div>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label class="ol-label" for="price">{t.price}</label>
              <input class="ol-input font-data" id="price" name="price" inputmode="decimal" required placeholder="420.00" />
            </div>
            <div>
              <label class="ol-label" for="cost">{t.cost}</label>
              <input class="ol-input font-data" id="cost" name="cost" inputmode="decimal" placeholder="0.00" />
            </div>
          </div>
          <div>
            <label class="ol-label" for="vprice_note">{t.priceNote}</label>
            <input
              class="ol-input"
              id="vprice_note"
              name="vprice_note"
              maxlength={VARIANT_PRICE_NOTE_MAX}
              aria-describedby="vprice_note-hint"
              placeholder={t.priceNotePlaceholder}
            />
            <p id="vprice_note-hint" class="mt-1 text-xs text-text-muted">{t.priceNoteHint}</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label class="ol-label" for="reorder_point">{t.reorderPoint}</label>
              <input class="ol-input font-data" id="reorder_point" name="reorder_point" inputmode="decimal" placeholder="5" />
            </div>
            <div>
              <label class="ol-label" for="public_stock_status">{t.publicStockStatus}</label>
              <select class="ol-select" id="public_stock_status" name="public_stock_status">
                {stockStatuses.map(([v, l]) => <option value={v}>{l}</option>)}
              </select>
            </div>
          </div>
          <label class="flex items-center gap-2 text-sm text-text-secondary">
            <input type="checkbox" name="track_inventory" checked /> {t.trackInventory}
          </label>
          {/* Per-variant storefront switch. The product flag is the master one;
              this only retires this card. */}
          <div class="rounded-xl border border-border p-3">
            <label class="flex items-center gap-2 text-sm font-medium text-text-secondary">
              <input type="checkbox" name="variant_is_public" id="variant_is_public" checked />
              <Icon name="lucide:eye" width={15} height={15} />
              {t.variantPublic}
            </label>
            <p class="mt-1 pl-6 text-xs text-text-muted">{t.variantPublicHint}</p>
          </div>
          <p id="variant-msg" class="hidden rounded-xl px-3 py-2 text-sm"></p>
          <div class="flex items-center justify-between border-t border-border pt-4">
            <button
              type="button"
              id="variant-delete"
              class="hidden text-sm font-medium text-danger hover:underline"
            >
              {t.deleteVariant}
            </button>
            <div class="ml-auto flex items-center gap-2">
              <Button type="button" variant="secondary" id="variant-cancel">
                {dict.common.cancel}
              </Button>
              <Button type="submit" variant="primary" id="variant-btn">
                <span data-label>{dict.common.save}</span>
              </Button>
            </div>
          </div>
        </form>
      </div>
      </div>
    </>
  )}
</DashboardLayout>

<script>
  import {
    variantDescription,
    variantDetailsError,
    variantIsPublic,
    variantPriceNote,
  } from "@/lib/variants";
  import { ui, uiLocale } from "@/lib/i18n-client";

  const t = ui().productDetail;

  const root = document.querySelector("[data-product-id]") as HTMLElement | null;
  if (root) {
    const businessId = root.dataset.businessId!;
    const productId = root.dataset.productId!;

    function flash(el: HTMLElement, ok: boolean, msg: string) {
      el.textContent = msg;
      el.className = `rounded-xl px-3 py-2 text-sm ${ok ? "bg-success-soft text-success" : "bg-danger-soft text-danger"}`;
    }

    const editForm = document.getElementById("edit-form") as HTMLFormElement;
    const editMsg = document.getElementById("edit-msg") as HTMLElement;
    editForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(editForm);
      const payload = {
        business_id: businessId,
        name: String(fd.get("name") || ""),
        brand: String(fd.get("brand") || ""),
        product_type: String(fd.get("product_type") || ""),
        description: String(fd.get("description") || ""),
        is_handmade: fd.get("is_handmade") === "on",
        is_public: fd.get("is_public") === "on",
        status: "active",
      };
      const res = await fetch(`/api/products/${productId}`, {
        method: "PATCH",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      flash(editMsg, res.ok, res.ok ? t.saved : data?.error || t.saveError);
    });

    // --- Variant add/edit modal (shared popup) ---
    const modal = document.getElementById("variant-modal") as HTMLElement;
    const vForm = document.getElementById("variant-form") as HTMLFormElement;
    const vMsg = document.getElementById("variant-msg") as HTMLElement;
    const vTitle = document.getElementById("variant-modal-title") as HTMLElement;
    const vBtnLabel = vForm?.querySelector("#variant-btn [data-label]") as HTMLElement;
    const deleteBtn = document.getElementById("variant-delete") as HTMLButtonElement;
    const set = (name: string, value: string) => {
      const el = vForm.elements.namedItem(name) as
        | HTMLInputElement
        | HTMLSelectElement
        | HTMLTextAreaElement
        | null;
      if (el) el.value = value;
    };

    // The uploader is rendered once and reused, so its value has to be loaded
    // (or cleared) every time the modal opens for a different variant.
    const imageUploader = document.querySelector<HTMLElement>('[data-image-uploader][data-id="variant-image"]');
    const imageUrlEl = document.getElementById("variant-image-url") as HTMLInputElement | null;
    const loadImage = (url: string) =>
      imageUploader?.dispatchEvent(new CustomEvent("image-set", { detail: url }));

    function openModal(variant?: Record<string, any>) {
      vMsg.className = "hidden";
      vForm.reset();
      loadImage(variant?.image_url ?? "");
      if (variant) {
        vTitle.textContent = t.editVariant;
        vBtnLabel.textContent = t.saveChanges;
        deleteBtn.classList.remove("hidden");
        set("variant_id", variant.id ?? "");
        set("vname", variant.name ?? "");
        set("vdescription", variantDescription(variant));
        set("vprice_note", variantPriceNote(variant));
        set("sku", variant.sku ?? "");
        set("barcode", variant.barcode ?? "");
        set("price", variant.price ?? "");
        set("cost", variant.cost ?? "");
        set("reorder_point", variant.reorder_point ?? "");
        set("public_stock_status", variant.public_stock_status ?? "unknown");
        (vForm.elements.namedItem("track_inventory") as HTMLInputElement).checked =
          variant.track_inventory !== false;
        // Absent means visible: the column defaults to true on the API.
        (vForm.elements.namedItem("variant_is_public") as HTMLInputElement).checked =
          variantIsPublic(variant);
      } else {
        vTitle.textContent = t.addVariant;
        vBtnLabel.textContent = ui().common.save;
        deleteBtn.classList.add("hidden");
        set("variant_id", "");
      }
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      // Keep the scroll gesture inside the overlay on touch devices.
      document.body.classList.add("overflow-hidden");
      modal.scrollTop = 0;
    }
    function closeModal() {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.classList.remove("overflow-hidden");
    }

    document.getElementById("variant-add-btn")?.addEventListener("click", () => openModal());
    document.querySelectorAll<HTMLElement>(".variant-edit").forEach((btn) => {
      btn.addEventListener("click", () => {
        try {
          openModal(JSON.parse(btn.dataset.variant || "{}"));
        } catch {
          openModal();
        }
      });
    });
    document.getElementById("variant-cancel")?.addEventListener("click", closeModal);
    document.getElementById("variant-modal-close")?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    vForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(vForm);
      const str = (k: string) => String(fd.get(k) || "").trim();
      const variantId = str("variant_id");
      const sku = str("sku");
      const description = str("vdescription");
      const priceNote = str("vprice_note");
      const detailsError = variantDetailsError(description, priceNote, uiLocale());
      if (detailsError) {
        flash(vMsg, false, detailsError);
        return;
      }
      // Only send optional fields when filled — the API parses cost/barcode/etc.
      // strictly and 500s on an empty decimal string.
      const payload: Record<string, unknown> = {
        business_id: businessId,
        product_id: productId,
        sku,
        name: str("vname") || sku,
        attributes: {},
        // Text fields are always sent: like image_url, "" is what clears them,
        // while omitting them would read as "leave unchanged".
        description,
        price_note: priceNote,
        price: str("price") || "0",
        public_stock_status: str("public_stock_status") || "unknown",
        track_inventory: fd.get("track_inventory") === "on",
        // Storefront switch for this card. Always sent so unticking it is a
        // real `false`, not an omitted "leave as is".
        is_public: fd.get("variant_is_public") === "on",
        currency: "MXN",
        status: "active",
        // Always sent: "" tells the API to remove the image. Omitting it would
        // mean "leave unchanged", which can't express a removal.
        image_url: String(imageUrlEl?.value ?? "").trim(),
      };
      const barcode = str("barcode");
      if (barcode) payload.barcode = barcode;
      const cost = str("cost");
      if (cost) payload.cost = cost;
      const reorder = str("reorder_point");
      if (reorder) payload.reorder_point = reorder;

      const res = await fetch(variantId ? `/api/variants/${variantId}` : "/api/variants", {
        method: variantId ? "PATCH" : "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (res.ok) {
        flash(vMsg, true, variantId ? t.variantUpdated : t.variantAdded);
        window.setTimeout(() => window.location.reload(), 350);
      } else {
        flash(vMsg, false, data?.error || t.variantSaveError);
      }
    });

    deleteBtn?.addEventListener("click", async () => {
      const variantId = String(
        (vForm.elements.namedItem("variant_id") as HTMLInputElement).value || "",
      );
      if (!variantId || !window.confirm(t.confirmArchive)) return;
      const res = await fetch(
        `/api/variants/${variantId}?business_id=${encodeURIComponent(businessId)}`,
        { method: "DELETE" },
      );
      const data = await res.json().catch(() => ({}));
      if (res.ok) {
        flash(vMsg, true, t.variantArchived);
        window.setTimeout(() => window.location.reload(), 350);
      } else {
        flash(vMsg, false, data?.error || t.variantArchiveError);
      }
    });
  }
</script>
