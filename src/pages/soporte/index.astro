---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

import PublicLayout from "@/layouts/PublicLayout.astro";
import Button from "@/components/ui/Button.astro";
import ArticleRow from "@/components/support/ArticleRow.astro";
import CategoryCard from "@/components/support/CategoryCard.astro";
import SupportSearch from "@/components/support/SupportSearch.astro";
import { interpolate, localePath, pluralize, useT } from "@/i18n";
import {
  SUPPORT_EMAIL,
  SUPPORT_WHATSAPP,
  supportArticles,
  supportCategories,
} from "@/lib/support";
import { TOUR_IDS } from "@/lib/tours";

const locale = Astro.locals.locale;
const t = useT(locale).support;
const url = (href: string) => localePath(locale, href);

const entries = await getCollection("support");
const articles = supportArticles(entries, locale, {
  includeDrafts: import.meta.env.DEV,
});
const categories = supportCategories(articles);

// Tour-backed guides first: they are the ones the design leads with.
const popular = [...articles]
  .sort((a, b) => Number(Boolean(b.data.tour)) - Number(Boolean(a.data.tour)))
  .slice(0, 6);

const totalTours = articles.filter((article) => article.data.tour).length;
const summary = interpolate(t.librarySummary, {
  articles: pluralize(articles.length, t.countOne, t.countOther),
  tours: pluralize(totalTours, t.tourCountOne, t.tourCountOther),
});
---

<PublicLayout title={t.title} description={t.description}>
  <section class="border-b border-border bg-accent-soft">
    <div class="mx-auto flex max-w-7xl flex-col items-center gap-4 px-4 py-14 text-center sm:px-6">
      <p class="text-xs font-semibold tracking-[0.12em] text-accent">{t.kicker}</p>
      <h1 class="font-heading text-3xl font-semibold sm:text-4xl">{t.heading}</h1>
      <p class="max-w-xl text-sm text-text-secondary sm:text-base">{t.subheading}</p>
      <SupportSearch />
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="font-heading text-xl font-semibold">{t.browseTitle}</h2>
      <p class="text-sm text-text-muted">{summary}</p>
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((category) => (
          <CategoryCard
            href={url(category.path)}
            icon={category.icon}
            label={t.categories[category.id].label}
            description={t.categories[category.id].description}
            meta={interpolate(t.librarySummary, {
              articles: pluralize(category.articles.length, t.countOne, t.countOther),
              tours: pluralize(category.tourCount, t.tourCountOne, t.tourCountOther),
            })}
          />
        ))
      }
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-[1fr_340px]">
      <section>
        <div class="flex items-center justify-between gap-3">
          <h2 class="font-heading text-xl font-semibold">{t.popularTitle}</h2>
        </div>
        <div class="mt-4 flex flex-col gap-2.5">
          {
            popular.length > 0 ? (
              popular.map((article) => (
                <ArticleRow
                  href={url(article.path)}
                  title={article.data.title}
                  tour={Boolean(article.data.tour)}
                  meta={`${article.data.tour ? t.tours.badge : t.tours.articleBadge} · ${interpolate(
                    t.article.readingTime,
                    { count: article.data.readingMinutes },
                  )}`}
                />
              ))
            ) : (
              <p class="ol-card px-4 py-6 text-center text-sm text-text-muted">{t.empty}</p>
            )
          }
        </div>
      </section>

      <aside class="flex flex-col gap-4">
        <section class="rounded-2xl border border-accent bg-accent-soft p-5">
          <div class="flex items-center gap-2">
            <Icon name="lucide:route" class="text-accent" width={18} height={18} />
            <h2 class="font-heading text-base font-semibold">{t.tours.title}</h2>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary">{t.tours.description}</p>
          <p class="mt-3 text-xs font-medium text-accent">
            {pluralize(TOUR_IDS.length, t.tourCountOne, t.tourCountOther)}
          </p>
        </section>

        <section class="ol-card p-5">
          <h2 class="font-heading text-base font-semibold">{t.contact.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary">{t.contact.description}</p>
          <div class="mt-3 flex flex-col gap-2">
            {
              SUPPORT_WHATSAPP && (
                <Button
                  variant="whatsapp"
                  size="sm"
                  block
                  icon="lucide:message-circle"
                  href={`https://wa.me/${SUPPORT_WHATSAPP}`}
                >
                  {t.contact.whatsapp}
                </Button>
              )
            }
            <Button
              variant="secondary"
              size="sm"
              block
              icon="lucide:mail"
              href={`mailto:${SUPPORT_EMAIL}`}
            >
              {SUPPORT_EMAIL}
            </Button>
          </div>
        </section>

        <p class="flex items-center gap-2 rounded-xl bg-success-soft px-4 py-3 text-xs font-semibold text-success">
          <span class="size-2 rounded-full bg-success"></span>
          {t.status.ok}
        </p>
      </aside>
    </div>
  </div>
</PublicLayout>
