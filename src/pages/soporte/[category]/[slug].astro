---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";

import SupportLayout from "@/layouts/SupportLayout.astro";
import ArticleRow from "@/components/support/ArticleRow.astro";
import ArticleToc from "@/components/support/ArticleToc.astro";
import Callout from "@/components/support/Callout.astro";
import Feedback from "@/components/support/Feedback.astro";
import Figure from "@/components/support/Figure.astro";
import SupportSideNav from "@/components/support/SupportSideNav.astro";
import TourBanner from "@/components/support/TourBanner.astro";
import TourButton from "@/components/support/TourButton.astro";
import {
  DEFAULT_LOCALE,
  intlLocale,
  interpolate,
  localePath,
  useT,
} from "@/i18n";
import {
  findSupportArticle,
  relatedSupportArticles,
  supportArticles,
  supportCategories,
  supportEditUrl,
} from "@/lib/support";

const locale = Astro.locals.locale;
const t = useT(locale).support;
const url = (href: string) => localePath(locale, href);

const { category = "", slug = "" } = Astro.params;

const entries = await getCollection("support");
const articles = supportArticles(entries, locale, {
  includeDrafts: import.meta.env.DEV,
});
const article = findSupportArticle(articles, category, slug);
if (!article) {
  return Astro.rewrite("/404");
}

const categories = supportCategories(articles);
const related = relatedSupportArticles(articles, article);
const { Content, headings } = await render(article.entry);

// The frontmatter `updated` is a plain calendar date, so it parses as UTC
// midnight. Formatting it in the server's zone (UTC-6 here) would render the
// previous day, so pin the formatter to UTC.
const updated = new Intl.DateTimeFormat(intlLocale(locale), {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
}).format(article.data.updated);

// The same slug serves both locales, so the switch is just the other prefix.
const otherLocale = locale === DEFAULT_LOCALE ? "en" : DEFAULT_LOCALE;
const hasTranslation = entries.some(
  (entry) => entry.id === `${otherLocale}/${category}/${slug}`,
);

// MDX authors get these without importing them in every file.
const components = { Callout, Figure, TourButton };
---

<SupportLayout
  title={`${article.data.title} — ${t.title}`}
  description={article.data.description}
  crumbs={[
    { label: t.categories[article.category].label, href: `/soporte/${article.category}` },
    { label: article.data.title },
  ]}
>
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-8 sm:px-6 lg:grid-cols-[250px_1fr] xl:grid-cols-[250px_1fr_230px]">
    <aside class="hidden lg:block">
      <SupportSideNav
        categories={categories}
        currentCategory={article.category}
        currentSlug={article.slug}
      />
    </aside>

    <article class="min-w-0">
      <p class="text-[11px] font-semibold uppercase tracking-wide text-accent">
        {t.categories[article.category].label}
      </p>
      <h1 class="mt-2 font-heading text-3xl font-semibold leading-tight">
        {article.data.title}
        {article.data.draft && (
          <span class="ml-2 align-middle rounded-full bg-warning-soft px-2 py-0.5 text-xs font-semibold text-warning">
            {t.article.draft}
          </span>
        )}
      </h1>

      <div class="mt-3 flex flex-wrap items-center gap-4 text-xs text-text-muted">
        <span class="flex items-center gap-1.5">
          <Icon name="lucide:calendar" width={14} height={14} />
          {interpolate(t.article.updated, { date: updated })}
        </span>
        <span class="flex items-center gap-1.5">
          <Icon name="lucide:timer" width={14} height={14} />
          {interpolate(t.article.readingTime, { count: article.data.readingMinutes })}
        </span>
        {
          hasTranslation && (
            <a
              href={localePath(otherLocale, article.path)}
              hreflang={otherLocale}
              lang={otherLocale}
              class="flex items-center gap-1.5 text-accent hover:underline"
            >
              <Icon name="lucide:languages" width={14} height={14} />
              {t.article.otherLocale}
            </a>
          )
        }
      </div>

      <ArticleToc headings={headings} class="mt-6 xl:hidden" />

      {article.data.tour && (
        <div class="mt-6">
          <TourBanner tour={article.data.tour} title={article.data.title} />
        </div>
      )}

      <div class="ol-prose mt-8">
        <Content components={components} />
      </div>

      <div class="mt-10">
        <Feedback docId={`${article.category}/${article.slug}`} title={article.data.title} />
      </div>

      {
        related.length > 0 && (
          <section class="mt-10">
            <h2 class="font-heading text-lg font-semibold">{t.article.related}</h2>
            <div class="mt-3 flex flex-col gap-2.5">
              {related.map((next) => (
                <ArticleRow
                  href={url(next.path)}
                  title={next.data.title}
                  tour={Boolean(next.data.tour)}
                  meta={`${next.data.tour ? t.tours.badge : t.tours.articleBadge} · ${interpolate(
                    t.article.readingTime,
                    { count: next.data.readingMinutes },
                  )}`}
                />
              ))}
            </div>
          </section>
        )
      }
    </article>

    <aside class="hidden flex-col gap-4 xl:flex">
      <ArticleToc headings={headings} />

      {
        article.data.tour && (
          <section class="rounded-xl bg-surface-inverse p-4">
            <div class="flex items-center gap-2">
              <Icon name="lucide:route" class="text-text-inverse" width={15} height={15} />
              <p class="font-heading text-sm font-semibold text-text-inverse">
                {t.tours.asideTitle}
              </p>
            </div>
            <p class="mt-1.5 text-xs leading-relaxed text-text-muted">
              {t.tours.asideDescription}
            </p>
            <TourButton tour={article.data.tour} size="sm" block class="mt-3" />
          </section>
        )
      }

      <a
        href={supportEditUrl(article.entry.id)}
        target="_blank"
        rel="noreferrer"
        class="flex items-center gap-2 px-1 text-xs text-text-muted hover:text-text-primary"
      >
        <Icon name="lucide:github" width={14} height={14} />
        {t.article.editOnGithub}
      </a>
    </aside>
  </div>
</SupportLayout>
