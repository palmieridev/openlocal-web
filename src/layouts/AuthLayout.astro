---
import { Icon } from "astro-icon/components";
import BaseLayout from "./BaseLayout.astro";
import { localePath, useT } from "@/i18n";

interface Props {
  title?: string;
}
const { title } = Astro.props;

const locale = Astro.locals.locale;
const t = useT(locale);
const home = localePath(locale, "/");
---

<BaseLayout title={title}>
  <div class="flex min-h-screen flex-col items-center justify-center gap-6 px-4 py-12">
    <a href={home} class="flex items-center gap-2">
      <span class="flex size-9 items-center justify-center rounded-lg bg-accent">
        <Icon name="lucide:store" class="text-text-inverse" width={20} height={20} />
      </span>
      <span class="font-heading text-xl font-semibold tracking-tight">OpenLocal</span>
    </a>
    <slot />
    <a href={home} class="text-sm text-text-muted hover:text-text-secondary">{t.auth.backHome}</a>
  </div>
</BaseLayout>
