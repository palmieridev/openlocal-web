---
import BaseLayout from "./BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, image, imageAlt } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} imageAlt={imageAlt}>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</BaseLayout>
