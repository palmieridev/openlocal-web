---
import { Icon } from "astro-icon/components";
import { UserButton } from "@clerk/astro/components";
import BaseLayout from "./BaseLayout.astro";
import TourLauncher from "@/components/dashboard/TourLauncher.astro";
import { getServerAuth } from "@/lib/api/server";
import { authedApi } from "@/lib/api/client";
import { localePath, useT } from "@/i18n";

interface Props {
  title?: string;
  active?: string;
}
const locale = Astro.locals.locale;
const t = useT(locale).dashboard;
const to = (href: string) => localePath(locale, href);

const { title = t.title, active = "inicio" } = Astro.props;

// Resolve the storefront link (best-effort) so "Tienda pública" points at the
// business's public page. Tolerate any failure — the sidebar must still render.
let storeHref = "";
try {
  const { token, businessId } = await getServerAuth(Astro);
  if (token && businessId) {
    const biz = await authedApi(token, businessId).getBusiness();
    if (biz?.slug) storeHref = to(`/business/${biz.slug}`);
  }
} catch {
  /* tolerate */
}

// Scanner is not a top-level destination — it lives inside Inventario and
// Analítica (where scanning a SKU is actionable), not in the global sidebar.
// `tour` is the `data-tour` anchor the guided tours target. Written out in full
// (rather than derived from `key`) so it stays greppable — `tours.test.ts`
// fails the build when a tour points at an anchor no longer in the markup.
const nav = [
  { key: "inicio", tour: "nav-inicio", label: t.navHome, icon: "lucide:layout-dashboard", href: to("/dashboard") },
  { key: "productos", tour: "nav-productos", label: t.navProducts, icon: "lucide:package", href: to("/dashboard/products") },
  { key: "inventario", tour: "nav-inventario", label: t.navInventory, icon: "lucide:boxes", href: to("/dashboard/inventory") },
  { key: "analitica", tour: "nav-analitica", label: t.navAnalytics, icon: "lucide:chart-column", href: to("/dashboard/analytics") },
  { key: "tienda", tour: "nav-tienda", label: t.navStorefront, icon: "lucide:globe", href: storeHref || "#", external: true },
  { key: "ajustes", tour: "nav-ajustes", label: t.navSettings, icon: "lucide:settings", href: to("/dashboard/settings") },
];
---

<BaseLayout title={title}>
  <div class="flex min-h-screen">
    {/* Mobile top bar */}
    <header class="fixed inset-x-0 top-0 z-40 flex h-14 items-center gap-3 border-b border-border bg-surface-primary px-4 md:hidden">
      <button
        id="ol-sidebar-btn"
        type="button"
        class="flex size-9 items-center justify-center rounded-lg text-text-secondary transition-colors hover:bg-surface-secondary"
        aria-label={t.openMenu}
        aria-expanded="false"
        aria-controls="ol-sidebar"
      >
        <Icon name="lucide:menu" width={20} height={20} />
      </button>
      <a href={to("/dashboard")} class="flex items-center gap-2">
        <span class="flex size-7 items-center justify-center rounded-lg bg-accent">
          <Icon name="lucide:store" class="text-text-inverse" width={16} height={16} />
        </span>
        <span class="font-heading text-base font-semibold">OpenLocal</span>
      </a>
    </header>

    {/* Backdrop (mobile drawer) */}
    <div id="ol-sidebar-backdrop" hidden class="fixed inset-0 z-40 bg-black/50 md:hidden"></div>

    {/* Sidebar */}
    <aside
      id="ol-sidebar"
      class="fixed inset-y-0 left-0 z-50 flex w-60 shrink-0 -translate-x-full flex-col bg-surface-inverse p-4 text-text-inverse transition-transform duration-200 md:static md:translate-x-0"
    >
      <a href={to("/")} class="mb-6 flex items-center gap-2 px-2">
        <span class="flex size-8 items-center justify-center rounded-lg bg-accent">
          <Icon name="lucide:store" class="text-text-inverse" width={18} height={18} />
        </span>
        <span class="font-heading text-lg font-semibold">OpenLocal</span>
      </a>

      <nav class="flex flex-1 flex-col gap-1">
        {nav.map((n) => (
          <a
            href={n.href}
            data-tour={n.tour}
            {...n.external && n.href !== "#" ? { target: "_blank", rel: "noreferrer" } : {}}
            class:list={[
              "flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors",
              n.href === "#" && "pointer-events-none opacity-40",
              n.key === active
                ? "bg-white/10 text-text-inverse"
                : "text-text-inverse/60 hover:bg-white/5 hover:text-text-inverse",
            ]}
          >
            <Icon name={n.icon} width={18} height={18} />
            {n.label}
            {n.external && n.href !== "#" && <Icon name="lucide:external-link" width={13} height={13} class="ml-auto opacity-60" />}
          </a>
        ))}
      </nav>

      <div class="mt-4 flex items-center gap-3 rounded-xl bg-white/5 px-3 py-2.5">
        <UserButton />
        <span class="text-sm text-text-inverse/70">{t.myAccount}</span>
      </div>
    </aside>

    {/* Content */}
    <div class="min-w-0 flex-1 overflow-x-clip bg-surface-primary pt-14 md:pt-0">
      <slot />
    </div>
  </div>

  <TourLauncher />

  <script>
    const btn = document.getElementById("ol-sidebar-btn");
    const sidebar = document.getElementById("ol-sidebar");
    const backdrop = document.getElementById("ol-sidebar-backdrop");

    function setOpen(open: boolean) {
      sidebar?.classList.toggle("-translate-x-full", !open);
      backdrop?.toggleAttribute("hidden", !open);
      btn?.setAttribute("aria-expanded", String(open));
    }

    btn?.addEventListener("click", () => {
      setOpen(sidebar?.classList.contains("-translate-x-full") ?? false);
    });
    backdrop?.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  </script>
</BaseLayout>
