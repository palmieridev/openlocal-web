---
import { Icon } from "astro-icon/components";
import { Show, UserButton } from "@clerk/astro/components";
import Button from "@/components/ui/Button.astro";
import LocaleSwitcher from "@/components/LocaleSwitcher.astro";
import { localePath, useT } from "@/i18n";

const locale = Astro.locals.locale;
const t = useT(locale);
// Post-rewrite, so paths here are always the unprefixed (canonical) route.
const path = Astro.url.pathname;
const links = [
  { href: "/", label: t.nav.home },
  { href: "/marketplace", label: t.nav.marketplace },
  { href: "/soporte", label: t.support.nav },
];
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
const url = (href: string) => localePath(locale, href);
---

<header class="sticky top-0 z-40 border-b border-border bg-surface-primary/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-6 px-4 sm:px-6">
    <a href={url("/")} class="flex items-center gap-2">
      <span class="flex size-8 items-center justify-center rounded-lg bg-accent">
        <Icon name="lucide:store" class="text-text-inverse" width={18} height={18} />
      </span>
      <span class="font-heading text-lg font-semibold tracking-tight">OpenLocal</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {links.map((l) => (
        <a
          href={url(l.href)}
          class:list={[
            "rounded-full px-3 py-1.5 text-sm font-medium transition-colors",
            isActive(l.href)
              ? "bg-surface-secondary text-text-primary"
              : "text-text-secondary hover:bg-surface-secondary",
          ]}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <LocaleSwitcher class="hidden sm:flex" />
      <Show when="signed-out">
        <Button variant="ghost" size="sm" href={url("/login")} class="hidden sm:inline-flex">
          {t.nav.signIn}
        </Button>
        <Button variant="primary" size="sm" href={url("/register/business")} icon="lucide:store">
          {t.nav.sell}
        </Button>
      </Show>
      <Show when="signed-in">
        <Button variant="ghost" size="sm" href={url("/dashboard")} class="hidden sm:inline-flex">
          {t.nav.panel}
        </Button>
        <UserButton />
      </Show>
      <button
        id="ol-menu-btn"
        type="button"
        class="flex size-9 items-center justify-center rounded-lg text-text-secondary transition-colors hover:bg-surface-secondary md:hidden"
        aria-label={t.nav.openMenu}
        aria-expanded="false"
        aria-controls="ol-mobile-menu"
      >
        <Icon name="lucide:menu" width={20} height={20} data-icon-open />
        <Icon name="lucide:x" width={20} height={20} data-icon-close class="hidden" />
      </button>
    </div>
  </div>

  <div id="ol-mobile-menu" hidden class="border-t border-border bg-surface-primary px-4 pb-4 pt-2 md:hidden">
    <nav class="flex flex-col gap-1">
      {links.map((l) => (
        <a
          href={url(l.href)}
          class:list={[
            "rounded-xl px-3 py-2.5 text-sm font-medium transition-colors",
            isActive(l.href)
              ? "bg-surface-secondary text-text-primary"
              : "text-text-secondary hover:bg-surface-secondary",
          ]}
        >
          {l.label}
        </a>
      ))}
      <Show when="signed-out">
        <a href={url("/login")} class="rounded-xl px-3 py-2.5 text-sm font-medium text-text-secondary transition-colors hover:bg-surface-secondary sm:hidden">
          {t.nav.signIn}
        </a>
      </Show>
      <Show when="signed-in">
        <a href={url("/dashboard")} class="rounded-xl px-3 py-2.5 text-sm font-medium text-text-secondary transition-colors hover:bg-surface-secondary sm:hidden">
          {t.nav.panel}
        </a>
      </Show>
      <LocaleSwitcher class="mt-2 self-start sm:hidden" />
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("ol-menu-btn");
  const menu = document.getElementById("ol-mobile-menu");
  const iconOpen = btn?.querySelector("[data-icon-open]");
  const iconClose = btn?.querySelector("[data-icon-close]");

  btn?.addEventListener("click", () => {
    const open = menu?.toggleAttribute("hidden") === false;
    btn.setAttribute("aria-expanded", String(open));
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
  });
</script>
