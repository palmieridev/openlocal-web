---
import { Icon } from "astro-icon/components";
import Badge from "./Badge.astro";
import { formatPrice, formatDistance, stockMeta } from "@/lib/format";
import { interpolate, useT } from "@/i18n";
import type { PublicStockStatus } from "@/types/api";

interface Props {
  name: string;
  meta?: string;
  price: string | number;
  currency?: string;
  /** Short caveat the owner attached to the variant price. */
  priceNote?: string | null;
  distanceKm?: number | null;
  stockStatus?: PublicStockStatus | string;
  imageUrl?: string | null;
  href?: string;
  /** Make the image open the page's <ImageLightbox />. Needs no `href`. */
  lightbox?: boolean;
}

const {
  name,
  meta,
  price,
  currency = "MXN",
  priceNote,
  distanceKm,
  stockStatus,
  imageUrl,
  href,
  lightbox = false,
} = Astro.props;

const note = priceNote?.trim() ?? "";
// A nested <button> inside the card's <a> would be invalid markup, so the
// zoom trigger only appears on cards that are not themselves a link.
const zoomable = lightbox && !href && !!imageUrl;

const locale = Astro.locals.locale;
const t = useT(locale);
const stock = stockMeta(stockStatus, locale);
const dist = formatDistance(distanceKm);
const Tag = href ? "a" : "div";
---

<Tag
  class="group flex flex-col overflow-hidden rounded-2xl bg-surface-card shadow-card border border-border/60 transition-shadow hover:shadow-md"
  {...href ? { href } : {}}
>
  {/* Photos are stored uncropped, so the tile letterboxes them (object-contain)
      instead of centre-cropping — a portrait shot loses nothing. */}
  <div
    data-card-image
    class="relative flex h-44 items-start justify-end bg-accent-soft p-3"
  >
    <img
      data-card-photo
      src={imageUrl || undefined}
      alt=""
      loading="lazy"
      decoding="async"
      class:list={["absolute inset-0 size-full object-contain", { hidden: !imageUrl }]}
    />
    {/* Always rendered so the dashboard preview can toggle it as the image changes. */}
    <Icon
      name="lucide:image"
      data-card-fallback
      class:list={["absolute inset-0 m-auto text-accent/30", { hidden: !!imageUrl }]}
      width={40}
      height={40}
    />
    {zoomable && (
      <button
        type="button"
        class="absolute inset-0 z-0 flex cursor-zoom-in items-center justify-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-accent"
        data-lightbox-src={imageUrl}
        data-lightbox-alt={interpolate(t.product.imageAlt, { name })}
        data-lightbox-caption={[name, meta].filter(Boolean).join(" · ")}
        aria-label={interpolate(t.product.viewFullImage, { name })}
      >
        <span class="rounded-full bg-black/45 p-2 text-white opacity-0 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100">
          <Icon name="lucide:zoom-in" width={18} height={18} />
        </span>
      </button>
    )}
    {stockStatus && (
      <Badge tone="stock" bg={stock.bg} fg={stock.fg} dot={stock.dot} class="relative z-10">{stock.label}</Badge>
    )}
  </div>

  <div class="flex flex-1 flex-col gap-1.5 p-4">
    <h3 class="font-heading text-base font-semibold leading-tight text-text-primary">
      {name}
    </h3>
    {meta && <p class="text-[13px] text-text-muted">{meta}</p>}

    <div class="mt-2 flex items-center justify-between">
      <span class="font-data text-lg font-semibold text-text-primary">
        {formatPrice(price, currency, locale)}
      </span>
      {dist && (
        <span class="flex items-center gap-1 text-xs text-text-muted">
          <Icon name="lucide:map-pin" width={13} height={13} />
          {dist}
        </span>
      )}
    </div>
    {note && (
      <p class="flex items-start gap-1.5 text-xs leading-snug text-text-muted" data-price-note>
        <Icon name="lucide:info" class="mt-px shrink-0 text-accent" width={12} height={12} />
        <span>{note}</span>
      </p>
    )}
    <slot name="details" />
  </div>
</Tag>
