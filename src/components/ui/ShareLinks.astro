---
import { Icon } from 'astro-icon/components';
import { useT } from '@/i18n';
interface Props {
  url: string;
  title: string;
  /** Icon controls for a compact action row, with accessible text labels. */
  compact?: boolean;
}
const { url, title, compact = false } = Astro.props;
const t = useT(Astro.locals.locale).shareStorefront;
const whatsapp = `https://wa.me/?text=${encodeURIComponent(`${title}\n${url}`)}`;
---
<div data-share-links class="min-w-0">
  <div class:list={["flex items-center gap-2", { "flex-wrap": !compact }]}>
    <slot />
    <button
      type="button"
      data-native-share
      data-url={url}
      data-title={title}
      aria-label={`${t.share}: ${title}`}
      title={t.share}
      class:list={[
        "inline-flex min-h-11 shrink-0 cursor-pointer items-center justify-center gap-2 rounded-full border border-border text-sm font-medium transition-colors hover:bg-surface-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
        compact ? "size-11" : "px-4 py-2",
      ]}
    >
      <Icon name="lucide:share-2" width={16} height={16} />
      <span class:list={{ "sr-only": compact }}>{t.share}</span>
    </button>
    <a
      href={whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${t.shareWhatsapp}: ${title}`}
      title={t.shareWhatsapp}
      class:list={[
        "inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-full border border-border text-sm font-medium transition-colors hover:bg-surface-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
        compact ? "size-11" : "px-4 py-2",
      ]}
    >
      <Icon name="lucide:message-circle" width={16} height={16} />
      <span class:list={{ "sr-only": compact }}>{t.shareWhatsapp}</span>
    </a>
  </div>
  <div data-share-fallback class="mt-2" hidden>
    <input type="url" readonly value={url} aria-label={t.copyLink} class="ol-input text-xs" />
  </div>
  <p data-share-status role="status" aria-live="polite" class="text-xs text-text-secondary [&:not(:empty)]:mt-2"></p>
</div>
<script>
  import { ui } from '@/lib/i18n-client';
  document.querySelectorAll<HTMLElement>('[data-share-links]').forEach(section => {
    const button = section.querySelector<HTMLButtonElement>('[data-native-share]');
    button?.addEventListener('click', async () => {
      const url = button.dataset.url!;
      const title = button.dataset.title!;
      if (navigator.share) {
        try { await navigator.share({ title, url }); return; }
        catch (err) { if (err instanceof Error && err.name === 'AbortError') return; }
      }
      const status = section.querySelector<HTMLElement>('[data-share-status]')!;
      try {
        await navigator.clipboard.writeText(url);
        status.textContent = ui().shareStorefront.copied;
      } catch {
        section.querySelector<HTMLElement>('[data-share-fallback]')!.hidden = false;
        const input = section.querySelector<HTMLInputElement>('input')!;
        input.focus(); input.select();
        status.textContent = ui().shareStorefront.copyManually;
      }
    });
  });
</script>
