---
import { Icon } from "astro-icon/components";

/**
 * Public image viewer. Render it once per page; every element carrying
 * `data-lightbox-src` (plus optional `data-lightbox-alt` / `data-lightbox-caption`)
 * opens it, so storefront cards only have to describe their image.
 *
 * It is a native `<dialog>` opened with `showModal()`, which gives us the modal
 * focus trap, the inert background, Escape-to-close and focus restored to the
 * trigger for free. Zoom is real: pinch + drag on touch (Pointer Events with
 * `touch-action: none`), wheel/double-click/buttons/keys on desktop, and the
 * image is always the complete original — `object-fit: contain`, never cropped.
 */
interface Props {
  /** Override when a page needs more than one viewer. */
  id?: string;
}

const { id = "image-lightbox" } = Astro.props;
const captionId = `${id}-caption`;
---

<dialog
  id={id}
  class="ol-lightbox"
  aria-labelledby={captionId}
  data-lightbox
>
  <div class="ol-lightbox-shell">
    <div class="flex items-start justify-between gap-3 p-3 sm:p-4">
      <p id={captionId} class="min-w-0 flex-1 truncate text-sm font-medium text-white/90" data-lightbox-caption></p>
      <button
        type="button"
        autofocus
        data-lightbox-close
        class="rounded-full bg-white/10 p-2 text-white transition-colors hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        aria-label="Cerrar imagen"
      >
        <Icon name="lucide:x" width={20} height={20} />
      </button>
    </div>

    <div class="ol-lightbox-stage" data-lightbox-stage>
      <img data-lightbox-img class="ol-lightbox-img" alt="" draggable="false" />
    </div>

    <div class="flex items-center justify-center gap-2 p-3 sm:p-4">
      <div class="flex items-center gap-1 rounded-full bg-white/10 p-1 text-white backdrop-blur">
        <button
          type="button"
          data-lightbox-zoom="out"
          class="rounded-full p-2 transition-colors hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          aria-label="Alejar"
        >
          <Icon name="lucide:zoom-out" width={18} height={18} />
        </button>
        <span
          class="font-data min-w-14 text-center text-xs tabular-nums"
          data-lightbox-level
          aria-live="polite"
        >100%</span>
        <button
          type="button"
          data-lightbox-zoom="in"
          class="rounded-full p-2 transition-colors hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          aria-label="Acercar"
        >
          <Icon name="lucide:zoom-in" width={18} height={18} />
        </button>
        <button
          type="button"
          data-lightbox-zoom="reset"
          class="rounded-full p-2 transition-colors hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          aria-label="Ver la imagen completa"
        >
          <Icon name="lucide:maximize" width={18} height={18} />
        </button>
      </div>
    </div>

    <p class="pb-3 text-center text-[11px] text-white/60 sm:pb-4">
      Pellizca para acercar · arrastra para mover · Esc para cerrar
    </p>
  </div>
</dialog>

<style is:global>
  .ol-lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: white;
    overflow: hidden;
  }

  .ol-lightbox::backdrop {
    background: rgb(0 0 0 / 0.88);
  }

  .ol-lightbox[open] .ol-lightbox-shell {
    display: flex;
  }

  .ol-lightbox-shell {
    display: none;
    flex-direction: column;
    width: 100%;
    height: 100%;
  }

  .ol-lightbox-stage {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    overflow: hidden;
    /* Required for pinch/pan: the browser must not claim the gesture. */
    touch-action: none;
    cursor: zoom-in;
  }

  .ol-lightbox-stage[data-zoomed="true"] {
    cursor: grab;
  }

  .ol-lightbox-stage[data-dragging="true"] {
    cursor: grabbing;
  }

  .ol-lightbox-img {
    max-width: 100%;
    max-height: 100%;
    /* The whole picture, never a crop. */
    object-fit: contain;
    transform-origin: center center;
    will-change: transform;
    user-select: none;
    -webkit-user-drag: none;
  }

  .ol-lightbox-stage[data-animate="true"] .ol-lightbox-img {
    transition: transform 150ms ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .ol-lightbox-stage[data-animate="true"] .ol-lightbox-img {
      transition: none;
    }
  }
</style>

<script>
  import {
    IDENTITY,
    MIN_SCALE,
    ZOOM_STEP,
    clampTransform,
    distanceBetween,
    focusFromClient,
    midpoint,
    panBy,
    pinchTransform,
    toggleZoom,
    transformStyle,
    zoomAt,
    type Bounds,
    type Point,
    type Transform,
  } from "@/lib/lightbox";

  const dialog = document.querySelector<HTMLDialogElement>("dialog[data-lightbox]");
  const stage = dialog?.querySelector<HTMLElement>("[data-lightbox-stage]");
  const img = dialog?.querySelector<HTMLImageElement>("[data-lightbox-img]");
  const caption = dialog?.querySelector<HTMLElement>("[data-lightbox-caption]");
  const level = dialog?.querySelector<HTMLElement>("[data-lightbox-level]");

  if (dialog && stage && img && caption && level) {
    let transform: Transform = { ...IDENTITY };
    const pointers = new Map<number, Point>();
    let pinchStart: { transform: Transform; center: Point; distance: number } | null = null;
    let dragPointer: number | null = null;
    let dragFrom: Point | null = null;
    let lastTap = 0;
    let scrollLock = "";

    /** Viewport + rendered (untransformed) image size, for the clamp. */
    function bounds(): Bounds {
      const rect = stage!.getBoundingClientRect();
      return {
        viewWidth: rect.width,
        viewHeight: rect.height,
        contentWidth: img!.offsetWidth || rect.width,
        contentHeight: img!.offsetHeight || rect.height,
      };
    }

    function apply(next: Transform, animate = false) {
      transform = next;
      stage!.dataset.animate = animate ? "true" : "false";
      stage!.dataset.zoomed = transform.scale > MIN_SCALE ? "true" : "false";
      img!.style.transform = transformStyle(transform);
      level!.textContent = `${Math.round(transform.scale * 100)}%`;
    }

    /** Buttons and keys zoom about the middle of the stage. */
    function zoomBy(factor: number, focus: Point = { x: 0, y: 0 }) {
      apply(zoomAt(transform, factor, focus, bounds()), true);
    }

    function open(trigger: HTMLElement) {
      const src = trigger.dataset.lightboxSrc;
      if (!src) return;
      img!.src = src;
      img!.alt = trigger.dataset.lightboxAlt || "";
      caption!.textContent =
        trigger.dataset.lightboxCaption || trigger.dataset.lightboxAlt || "Imagen";
      apply({ ...IDENTITY });
      if (!dialog!.open) {
        // showModal() alone still lets some browsers scroll the page behind.
        scrollLock = document.documentElement.style.overflow;
        document.documentElement.style.overflow = "hidden";
        dialog!.showModal();
      }
      // The layout box is only known once the file is decoded; re-clamp then.
      img!.decode?.().then(() => apply({ ...IDENTITY })).catch(() => {});
    }

    // Delegated: cards render only the data attributes, no per-card wiring.
    document.addEventListener("click", (event) => {
      const target = (event.target as HTMLElement | null)?.closest<HTMLElement>(
        "[data-lightbox-src]",
      );
      if (!target) return;
      event.preventDefault();
      open(target);
    });

    // Fires for the close button, Escape and form dismissal alike.
    dialog.addEventListener("close", () => {
      pointers.clear();
      pinchStart = null;
      dragPointer = null;
      dragFrom = null;
      document.documentElement.style.overflow = scrollLock;
      apply({ ...IDENTITY });
    });

    dialog.querySelector<HTMLButtonElement>("[data-lightbox-close]")?.addEventListener("click", () =>
      dialog.close(),
    );

    dialog.querySelectorAll<HTMLButtonElement>("[data-lightbox-zoom]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = btn.dataset.lightboxZoom;
        if (mode === "in") zoomBy(ZOOM_STEP);
        else if (mode === "out") zoomBy(1 / ZOOM_STEP);
        else apply({ ...IDENTITY }, true);
      });
    });

    // Clicking the empty area around the picture closes, like a native viewer.
    stage.addEventListener("click", (event) => {
      if (event.target === stage && transform.scale === MIN_SCALE) dialog.close();
    });

    stage.addEventListener("dblclick", (event) => {
      event.preventDefault();
      apply(toggleZoom(transform, focusFromClient(pointOf(event), stage.getBoundingClientRect()), bounds()), true);
    });

    stage.addEventListener(
      "wheel",
      (event) => {
        event.preventDefault();
        const focus = focusFromClient(pointOf(event), stage.getBoundingClientRect());
        zoomBy(event.deltaY < 0 ? ZOOM_STEP : 1 / ZOOM_STEP, focus);
      },
      { passive: false },
    );

    function pointOf(event: { clientX: number; clientY: number }): Point {
      return { x: event.clientX, y: event.clientY };
    }

    stage.addEventListener("pointerdown", (event) => {
      stage.setPointerCapture(event.pointerId);
      pointers.set(event.pointerId, pointOf(event));
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        const rect = stage.getBoundingClientRect();
        pinchStart = {
          transform,
          center: focusFromClient(midpoint(a, b), rect),
          distance: distanceBetween(a, b),
        };
        dragPointer = null;
      } else if (pointers.size === 1 && transform.scale > MIN_SCALE) {
        dragPointer = event.pointerId;
        dragFrom = pointOf(event);
        stage.dataset.dragging = "true";
      }
    });

    stage.addEventListener("pointermove", (event) => {
      if (!pointers.has(event.pointerId)) return;
      pointers.set(event.pointerId, pointOf(event));

      if (pointers.size >= 2 && pinchStart) {
        const [a, b] = [...pointers.values()];
        const rect = stage.getBoundingClientRect();
        apply(
          pinchTransform(
            pinchStart.transform,
            { center: pinchStart.center, distance: pinchStart.distance },
            { center: focusFromClient(midpoint(a, b), rect), distance: distanceBetween(a, b) },
            bounds(),
          ),
        );
        return;
      }

      if (dragPointer === event.pointerId && dragFrom) {
        const now = pointOf(event);
        apply(panBy(transform, { x: now.x - dragFrom.x, y: now.y - dragFrom.y }, bounds()));
        dragFrom = now;
      }
    });

    function endPointer(event: PointerEvent) {
      pointers.delete(event.pointerId);
      if (pointers.size < 2) pinchStart = null;
      if (dragPointer === event.pointerId) {
        dragPointer = null;
        dragFrom = null;
        stage!.dataset.dragging = "false";
      }
      // A remaining finger keeps panning from where it is now.
      if (pointers.size === 1 && transform.scale > MIN_SCALE) {
        const [id] = [...pointers.keys()];
        dragPointer = id;
        dragFrom = pointers.get(id) ?? null;
      }
    }

    stage.addEventListener("pointerup", (event) => {
      // Double tap toggles zoom on touch, where dblclick is unreliable.
      if (event.pointerType === "touch" && pointers.size === 1) {
        const now = Date.now();
        if (now - lastTap < 300) {
          apply(
            toggleZoom(transform, focusFromClient(pointOf(event), stage.getBoundingClientRect()), bounds()),
            true,
          );
          lastTap = 0;
        } else {
          lastTap = now;
        }
      }
      endPointer(event);
    });
    stage.addEventListener("pointercancel", endPointer);

    // Keyboard zoom/pan for anyone not using a pointer.
    dialog.addEventListener("keydown", (event) => {
      const step = 60;
      switch (event.key) {
        case "+":
        case "=":
          event.preventDefault();
          zoomBy(ZOOM_STEP);
          break;
        case "-":
          event.preventDefault();
          zoomBy(1 / ZOOM_STEP);
          break;
        case "0":
          event.preventDefault();
          apply({ ...IDENTITY }, true);
          break;
        case "ArrowLeft":
        case "ArrowRight":
        case "ArrowUp":
        case "ArrowDown": {
          if (transform.scale === MIN_SCALE) return;
          event.preventDefault();
          const delta = {
            x: event.key === "ArrowLeft" ? step : event.key === "ArrowRight" ? -step : 0,
            y: event.key === "ArrowUp" ? step : event.key === "ArrowDown" ? -step : 0,
          };
          apply(panBy(transform, delta, bounds()), true);
          break;
        }
      }
    });

    // Re-clamp when the viewport changes under an open dialog (rotation).
    window.addEventListener("resize", () => {
      if (dialog.open) apply(clampTransform(transform, bounds()));
    });
  }
</script>
