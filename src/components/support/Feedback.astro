---
import { Icon } from "astro-icon/components";
import Button from "@/components/ui/Button.astro";
import { useT } from "@/i18n";

interface Props {
  /** `<category>/<slug>` — stable across locales, so both roll up together. */
  docId: string;
  /** Article title, used to prefill the GitHub issue. */
  title: string;
}

const { docId, title } = Astro.props;
const locale = Astro.locals.locale;
const t = useT(locale).support.feedback;

const issueUrl = new URL("https://github.com/palmieridev/openlocal-web/issues/new");
issueUrl.searchParams.set("title", `Soporte: ${title}`);
issueUrl.searchParams.set(
  "body",
  `<!-- ${docId} (${locale}) -->\n\n`,
);
---

<section
  class="ol-card p-5"
  data-support-feedback
  data-doc-id={docId}
  data-locale={locale}
>
  <div class="flex flex-wrap items-center justify-between gap-3" data-step="ask">
    <p class="text-sm font-semibold text-text-primary">{t.question}</p>
    <div class="flex items-center gap-2">
      <Button variant="secondary" size="sm" icon="lucide:thumbs-up" data-verdict="up">
        {t.yes}
      </Button>
      <Button variant="secondary" size="sm" icon="lucide:thumbs-down" data-verdict="down">
        {t.no}
      </Button>
    </div>
  </div>

  <div class="hidden" data-step="comment">
    <label class="ol-label" for={`fb-${docId}`}>{t.commentLabel}</label>
    <textarea
      id={`fb-${docId}`}
      class="ol-textarea"
      rows="3"
      maxlength="1000"
      placeholder={t.commentPlaceholder}></textarea>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <Button variant="primary" size="sm" icon="lucide:send" data-send>{t.send}</Button>
      <a
        href={issueUrl.href}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-1.5 text-xs font-medium text-text-muted hover:text-text-primary"
      >
        <Icon name="lucide:github" width={14} height={14} />
        {t.openIssue}
      </a>
    </div>
  </div>

  <p
    class="hidden items-center gap-2 text-sm font-medium text-success"
    data-step="thanks"
    role="status"
  >
    <Icon name="lucide:circle-check" width={16} height={16} />
    <span>{t.thanks}</span>
  </p>

  <p class="mt-2 hidden text-sm text-danger" data-step="error" role="alert">{t.error}</p>
</section>

<script>
  import { ui } from "@/lib/i18n-client";

  type Verdict = "up" | "down";

  document.querySelectorAll<HTMLElement>("[data-support-feedback]").forEach((root) => {
    const docId = root.dataset.docId ?? "";
    const locale = root.dataset.locale ?? "es";
    const ask = root.querySelector<HTMLElement>('[data-step="ask"]');
    const comment = root.querySelector<HTMLElement>('[data-step="comment"]');
    const thanks = root.querySelector<HTMLElement>('[data-step="thanks"]');
    const error = root.querySelector<HTMLElement>('[data-step="error"]');
    const textarea = root.querySelector<HTMLTextAreaElement>("textarea");
    const send = root.querySelector<HTMLButtonElement>("[data-send]");

    let verdict: Verdict | null = null;
    let sent = false;

    const show = (el: HTMLElement | null, visible: boolean, display = "block") => {
      if (!el) return;
      el.classList.toggle("hidden", !visible);
      if (visible) el.style.display = display;
    };

    async function post(body: Record<string, unknown>): Promise<boolean> {
      try {
        const res = await fetch("/api/support/feedback", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(body),
        });
        return res.ok;
      } catch {
        return false;
      }
    }

    async function submit(withComment: boolean) {
      if (sent || !verdict) return;
      sent = true;
      const t = ui().support.feedback;
      if (send) {
        send.disabled = true;
        send.textContent = t.sending;
      }
      const ok = await post({
        doc_id: docId,
        locale,
        verdict,
        comment: withComment ? textarea?.value ?? null : null,
        path: window.location.pathname,
      });
      if (ok) {
        show(ask, false);
        show(comment, false);
        show(thanks, true, "flex");
        show(error, false);
      } else {
        sent = false;
        show(error, true);
        if (send) {
          send.disabled = false;
          send.textContent = t.send;
        }
      }
    }

    root.querySelectorAll<HTMLElement>("[data-verdict]").forEach((btn) => {
      btn.addEventListener("click", () => {
        verdict = btn.dataset.verdict === "down" ? "down" : "up";
        if (verdict === "up") {
          void submit(false);
          return;
        }
        // A thumbs-down is only useful with the "what was missing" answer, so
        // the negative path collects the comment before sending.
        show(ask, false);
        show(comment, true);
        textarea?.focus();
      });
    });

    send?.addEventListener("click", () => void submit(true));
  });
</script>
