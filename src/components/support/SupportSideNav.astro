---
import { Icon } from "astro-icon/components";
import { localePath, useT } from "@/i18n";
import type { SupportCategory } from "@/lib/support";

interface Props {
  categories: SupportCategory[];
  currentCategory?: string;
  currentSlug?: string;
}

const { categories, currentCategory, currentSlug } = Astro.props;
const locale = Astro.locals.locale;
const t = useT(locale).support;
const url = (href: string) => localePath(locale, href);
---

<nav class="flex flex-col gap-5" aria-label={t.nav}>
  {
    categories
      .filter((category) => category.articles.length > 0)
      .map((category) => (
        <div class="flex flex-col gap-1">
          <a
            href={url(category.path)}
            class:list={[
              "text-[11px] font-semibold uppercase tracking-wide hover:text-text-secondary",
              category.id === currentCategory ? "text-text-secondary" : "text-text-muted",
            ]}
          >
            {t.categories[category.id].label}
          </a>
          {category.articles.map((article) => {
            const active =
              article.category === currentCategory && article.slug === currentSlug;
            return (
              <a
                href={url(article.path)}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "flex items-center gap-2 rounded-lg px-2.5 py-2 text-sm transition-colors",
                  active
                    ? "bg-accent-soft font-semibold text-accent"
                    : "text-text-secondary hover:bg-surface-secondary",
                ]}
              >
                <span class="min-w-0 flex-1 truncate">{article.data.title}</span>
                {article.data.tour && (
                  <Icon
                    name="lucide:route"
                    class={active ? "shrink-0 text-accent" : "shrink-0 text-text-muted"}
                    width={13}
                    height={13}
                  />
                )}
              </a>
            );
          })}
        </div>
      ))
  }
</nav>
