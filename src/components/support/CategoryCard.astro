---
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  icon: string;
  label: string;
  description: string;
  meta: string;
}

const { href, icon, label, description, meta } = Astro.props;
---

<a
  href={href}
  class="ol-card group flex flex-col gap-2.5 p-5 transition-colors hover:border-accent/40 hover:bg-accent-soft/30"
>
  <span class="flex size-9 items-center justify-center rounded-lg bg-accent-soft">
    <Icon name={icon} class="text-accent" width={18} height={18} />
  </span>
  <h3 class="font-heading text-base font-semibold text-text-primary">{label}</h3>
  <p class="text-sm leading-relaxed text-text-secondary">{description}</p>
  <span class="mt-auto text-xs font-medium text-text-muted">{meta}</span>
</a>
