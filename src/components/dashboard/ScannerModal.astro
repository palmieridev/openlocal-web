---
import { Icon } from "astro-icon/components";
import { useT } from "@/i18n";

const dict = useT(Astro.locals.locale);
const t = dict.scanner;

// Barcode scanner modal. Client-only: camera + manual entry → /api/lookup.
// Open with `window.openScanner()` or any `[data-open-scanner]` trigger.
// Needs the business id — read from `[data-business-id]` on the page root.
// A found variant hands off to `window.openMovementModal` (MovementEditModal)
// if present; otherwise falls back to the product edit link.
---

<div id="sc-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
  <div class="ol-card flex max-h-[85vh] w-full max-w-md flex-col gap-3.5 overflow-y-auto p-5 shadow-xl">
    <div class="flex items-start justify-between">
      <div>
        <h2 class="font-heading font-semibold">{t.title}</h2>
        <p class="text-sm text-text-muted">{t.subtitle}</p>
      </div>
      <button
        type="button"
        id="sc-close"
        class="text-text-muted hover:text-text-secondary"
        aria-label={dict.common.close}
      >
        <Icon name="lucide:x" width={18} height={18} />
      </button>
    </div>

    <div class="overflow-hidden rounded-xl bg-surface-inverse">
      <div id="sc-reader" class="aspect-square w-full"></div>
    </div>

    <div class="flex items-center justify-between gap-2">
      <button type="button" id="sc-start" class="inline-flex items-center gap-2 rounded-full border border-border bg-surface-card px-3.5 py-2 text-sm font-medium text-text-primary hover:bg-surface-secondary">
        <Icon name="lucide:camera" width={16} height={16} /> {t.startCamera}
      </button>
      <button type="button" id="sc-stop" class="inline-flex items-center gap-2 rounded-full px-3.5 py-2 text-sm font-medium text-text-secondary hover:bg-surface-secondary">
        <Icon name="lucide:square" width={16} height={16} /> {t.stopCamera}
      </button>
    </div>

    <label class="flex items-center gap-2 rounded-lg border border-border bg-surface-primary px-3.5 py-3">
      <Icon name="lucide:keyboard" class="text-text-muted" width={16} height={16} />
      <input
        id="sc-manual"
        inputmode="numeric"
        placeholder={t.manualPlaceholder}
        class="w-full bg-transparent font-data text-sm text-text-primary placeholder:text-text-muted focus:outline-none"
      />
      <button
        type="button"
        id="sc-manual-btn"
        class="shrink-0 text-sm font-semibold text-accent hover:underline"
      >
        {t.search}
      </button>
    </label>

    <div id="sc-result" class="hidden"></div>
  </div>
</div>

<script>
  import { Html5Qrcode } from "html5-qrcode";
  import { localePath } from "@/i18n";
  import { ui, uiLocale } from "@/lib/i18n-client";

  const t = ui().scanner;
  const to = (href: string) => localePath(uiLocale(), href);

  const modal = document.getElementById("sc-modal");
  if (modal && !(window as any).__scInit) {
    (window as any).__scInit = true;

    const resultEl = document.getElementById("sc-result") as HTMLElement;
    const manual = document.getElementById("sc-manual") as HTMLInputElement;

    // business id from the page root cookie mirror
    const root = document.querySelector("[data-business-id]") as HTMLElement | null;
    const businessId = root?.dataset.businessId ?? "";

    let scanner: Html5Qrcode | null = null;
    let busy = false;

    function openScanner() {
      modal!.classList.remove("hidden");
      modal!.classList.add("flex");
    }
    async function closeScanner() {
      await stopCamera();
      modal!.classList.add("hidden");
      modal!.classList.remove("flex");
      resultEl.classList.add("hidden");
      resultEl.innerHTML = "";
    }
    (window as any).openScanner = openScanner;

    async function startCamera() {
      if (scanner) return;
      if (!window.isSecureContext) {
        renderMsg(t.insecureContext, "warning");
        return;
      }
      if (!navigator.mediaDevices?.getUserMedia) {
        renderMsg(t.unsupported, "warning");
        return;
      }
      scanner = new Html5Qrcode("sc-reader");
      try {
        await scanner.start(
          { facingMode: "environment" },
          { fps: 10, qrbox: { width: 240, height: 160 } },
          (decoded) => lookup(decoded),
          () => {},
        );
      } catch (err: any) {
        scanner = null;
        const name = err?.name ?? "";
        const reason =
          name === "NotAllowedError" ? t.permissionDenied
          : name === "NotFoundError" ? t.noCamera
          : (err?.message || t.cameraFailed);
        renderMsg(`${reason} ${t.useManual}`, "warning");
      }
    }
    async function stopCamera() {
      if (scanner) {
        await scanner.stop().catch(() => {});
        try { scanner.clear(); } catch { /* ignore */ }
        scanner = null;
      }
    }

    function renderMsg(text: string, tone: "warning" | "danger") {
      const cls = tone === "danger" ? "bg-danger-soft text-danger" : "bg-warning-soft text-warning";
      resultEl.className = `mt-1 rounded-xl px-3.5 py-3 text-sm ${cls}`;
      resultEl.textContent = text;
      resultEl.classList.remove("hidden");
    }

    function renderFound(v: any) {
      resultEl.className = "ol-card mt-1 p-4";
      resultEl.innerHTML = `
        <div class="flex items-center gap-1.5 text-sm font-semibold text-success">
          <span>✓</span> ${t.found}
        </div>
        <div class="mt-1.5 font-medium text-text-primary">${v.name ?? v.sku ?? t.variantFallback}</div>
        ${v.sku ? `<div class="font-data text-xs text-text-muted">${v.sku}</div>` : ""}
        <div class="mt-3 flex gap-2">
          <button type="button" data-sc-move class="flex-1 rounded-full bg-accent py-2.5 text-sm font-semibold text-text-inverse hover:bg-accent/90">${t.logMovement}</button>
          ${v.product_id ? `<a href="${to(`/dashboard/products/${v.product_id}`)}" class="flex-1 rounded-full border border-border py-2.5 text-center text-sm font-semibold text-text-primary hover:bg-surface-secondary">${t.viewProduct}</a>` : ""}
        </div>`;
      resultEl.classList.remove("hidden");
      resultEl.querySelector<HTMLButtonElement>("[data-sc-move]")?.addEventListener("click", async () => {
        const open = (window as any).openMovementModal;
        if (open) {
          await closeScanner();
          open({ variantId: v.id, variantName: v.name ?? v.sku, variantSku: v.sku ?? "", mode: "entrada" });
        } else {
          window.location.href = to(
            v.product_id ? `/dashboard/products/${v.product_id}` : "/dashboard/inventory",
          );
        }
      });
    }

    function renderNotFound(code: string) {
      resultEl.className = "ol-card mt-1 p-4";
      resultEl.innerHTML = `
        <div class="text-sm font-semibold text-warning">${t.notFound}</div>
        <div class="font-data mt-1 text-xs text-text-muted">${code}</div>
        <p class="mt-2 text-[13px] text-text-secondary">${t.notFoundHelp}</p>
        <div class="mt-3 flex flex-col gap-2">
          <input data-sc-name class="ol-input" placeholder="${t.productNamePlaceholder}" />
          <div class="flex gap-2">
            <input data-sc-sku class="ol-input font-data flex-1" placeholder="${t.skuPlaceholder}" />
            <input data-sc-price class="ol-input font-data w-28" inputmode="decimal" placeholder="${t.pricePlaceholder}" />
          </div>
        </div>
        <p data-sc-err class="mt-2 hidden rounded-lg bg-danger-soft px-3 py-2 text-sm text-danger"></p>
        <button type="button" data-sc-create class="mt-3 w-full rounded-full bg-accent py-2.5 text-sm font-semibold text-text-inverse hover:bg-accent/90 disabled:opacity-50">${t.createBoth}</button>`;
      resultEl.classList.remove("hidden");

      const nameEl = resultEl.querySelector<HTMLInputElement>("[data-sc-name]")!;
      const skuEl = resultEl.querySelector<HTMLInputElement>("[data-sc-sku]")!;
      const priceEl = resultEl.querySelector<HTMLInputElement>("[data-sc-price]")!;
      const errEl = resultEl.querySelector<HTMLElement>("[data-sc-err]")!;
      const btn = resultEl.querySelector<HTMLButtonElement>("[data-sc-create]")!;
      nameEl.focus();

      btn.addEventListener("click", () => createProductAndVariant(code, { nameEl, skuEl, priceEl, errEl, btn }));
    }

    // Two-step create: product ficha, then its first variant carrying the barcode.
    async function createProductAndVariant(
      code: string,
      f: { nameEl: HTMLInputElement; skuEl: HTMLInputElement; priceEl: HTMLInputElement; errEl: HTMLElement; btn: HTMLButtonElement },
    ) {
      const name = f.nameEl.value.trim();
      if (!name) {
        f.errEl.textContent = t.nameRequired;
        f.errEl.classList.remove("hidden");
        f.nameEl.focus();
        return;
      }
      f.errEl.classList.add("hidden");
      f.btn.disabled = true;
      f.btn.textContent = ui().common.creating;
      const fail = (msg: string) => {
        f.errEl.textContent = msg;
        f.errEl.classList.remove("hidden");
        f.btn.disabled = false;
        f.btn.textContent = t.createBoth;
      };
      try {
        // 1) product ficha
        const pRes = await fetch("/api/products", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            business_id: businessId,
            name,
            product_type: "stocked_product",
            unit: "",
            brand: "",
            description: "",
            is_handmade: false,
            is_public: true,
            status: "active",
          }),
        });
        const product = await pRes.json();
        if (!pRes.ok) return fail(product?.error || t.createFailed);

        // 2) first variant with the scanned barcode
        const vRes = await fetch("/api/variants", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            business_id: businessId,
            product_id: product.id,
            sku: f.skuEl.value.trim() || code,
            name,
            attributes: {},
            price: f.priceEl.value.trim() || "0",
            barcode: code,
            // Scanned items go straight to the storefront: the product flag is
            // true above, so the card needs the variant flag on as well.
            is_public: true,
            public_stock_status: "unknown",
            track_inventory: true,
            currency: "MXN",
            status: "active",
          }),
        });
        if (!vRes.ok) {
          // Product exists but variant failed — send them to finish it by hand.
          window.location.href = to(`/dashboard/products/${product.id}`);
          return;
        }
        // Done — open the product to set price/inventory.
        window.location.href = to(`/dashboard/products/${product.id}`);
      } catch {
        fail(t.networkError);
      }
    }

    async function lookup(code: string) {
      code = code.trim();
      if (!code || busy) return;
      busy = true;
      try {
        const res = await fetch(`/api/lookup?barcode=${encodeURIComponent(code)}&business_id=${encodeURIComponent(businessId)}`);
        const data = await res.json();
        if (res.ok) renderFound(data);
        else renderNotFound(code);
      } catch {
        renderMsg(t.networkError, "danger");
      } finally {
        setTimeout(() => (busy = false), 1200);
      }
    }

    // triggers
    document.querySelectorAll<HTMLElement>("[data-open-scanner]").forEach((el) =>
      el.addEventListener("click", (e) => {
        e.preventDefault();
        openScanner();
      }),
    );
    document.getElementById("sc-close")?.addEventListener("click", closeScanner);
    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeScanner();
    });
    document.getElementById("sc-start")?.addEventListener("click", startCamera);
    document.getElementById("sc-stop")?.addEventListener("click", stopCamera);
    document.getElementById("sc-manual-btn")?.addEventListener("click", () => lookup(manual.value));
    manual?.addEventListener("keydown", (e) => {
      if (e.key === "Enter") lookup(manual.value);
    });
  }
</script>
