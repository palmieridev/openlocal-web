---
import { Icon } from "astro-icon/components";
import Button from "@/components/ui/Button.astro";

export interface ExistRow {
  variantId: string;
  name: string;
  sku: string;
  qty: string;
  reorder: string;
  low: boolean;
}
interface Props {
  rows: ExistRow[];
}
const { rows } = Astro.props;
---

{rows.length > 0 ? (
  <div class="ol-card overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-border text-left text-xs uppercase tracking-wide text-text-muted">
          <th class="px-5 py-3 font-medium">Producto / SKU</th>
          <th class="px-5 py-3 text-right font-medium">En mano</th>
          <th class="px-5 py-3 text-right font-medium">Reorden</th>
          <th class="px-5 py-3 font-medium">Estado</th>
          <th class="px-5 py-3 text-right font-medium">Acciones</th>
        </tr>
      </thead>
      <tbody id="stock-rows" class="divide-y divide-border">
        {rows.map((r) => (
          <tr
            class="stock-row hover:bg-surface-primary/50"
            data-low={r.low ? "1" : "0"}
            data-search={`${r.name} ${r.sku}`.toLowerCase()}
            data-variant-id={r.variantId}
            data-name={r.name}
            data-sku={r.sku}
          >
            <td class="px-5 py-3">
              <div class="font-medium text-text-primary">{r.name}</div>
              {r.sku && <div class="font-data text-xs text-text-muted">{r.sku}</div>}
            </td>
            <td class="px-5 py-3 text-right font-data">{r.qty}</td>
            <td class="px-5 py-3 text-right font-data text-text-muted">{r.reorder}</td>
            <td class="px-5 py-3">
              {r.low ? (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-warning-soft px-2.5 py-1 text-[11px] font-semibold text-warning">
                  <Icon name="lucide:triangle-alert" width={12} height={12} /> Bajo
                </span>
              ) : (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-success-soft px-2.5 py-1 text-[11px] font-semibold text-success">
                  <span class="size-1.5 rounded-full bg-success"></span> OK
                </span>
              )}
            </td>
            <td class="px-5 py-3">
              <div class="flex items-center justify-end gap-1.5">
                <button type="button" class="stock-action inline-flex items-center gap-1 rounded-lg border border-border px-2.5 py-1.5 text-xs font-medium text-success hover:bg-success-soft" data-move="entrada">
                  <Icon name="lucide:plus" width={13} height={13} /> Entrada
                </button>
                <button type="button" class="stock-action inline-flex items-center gap-1 rounded-lg border border-border px-2.5 py-1.5 text-xs font-medium text-danger hover:bg-danger-soft" data-move="salida">
                  <Icon name="lucide:minus" width={13} height={13} /> Salida
                </button>
                <button type="button" class="stock-action inline-flex items-center gap-1 rounded-lg border border-border px-2.5 py-1.5 text-xs font-medium text-text-secondary hover:bg-surface-secondary" data-move="ajuste">
                  <Icon name="lucide:sliders-horizontal" width={13} height={13} /> Ajuste
                </button>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <p id="no-results" class="hidden px-5 py-10 text-center text-sm text-text-muted">Sin resultados.</p>
  </div>
) : (
  <div class="ol-card border-dashed p-12 text-center">
    <Icon name="lucide:boxes" class="mx-auto text-text-muted" width={32} height={32} />
    <p class="mt-3 text-sm text-text-secondary">Sin existencias registradas. Crea una variante con seguimiento de inventario y registra su primer movimiento.</p>
    <div class="mt-4 flex justify-center gap-2">
      <Button variant="secondary" size="sm" icon="lucide:package" href="/dashboard/products">Ver productos</Button>
      <Button variant="primary" size="sm" icon="lucide:plus" data-open-picker>Registrar movimiento</Button>
    </div>
  </div>
)}
