---
interface Props {
  active: "levels" | "movements" | "adjust" | "scan";
}
const { active } = Astro.props;
const tabs = [
  { key: "levels", label: "Existencias", href: "/dashboard/inventory" },
  { key: "movements", label: "Movimientos", href: "/dashboard/inventory/movements" },
  { key: "adjust", label: "Registrar", href: "/dashboard/inventory/adjust" },
  { key: "scan", label: "Escanear", href: "/dashboard/inventory/scan" },
];
---

<nav class="mt-4 flex gap-1 rounded-full border border-border bg-surface-card p-1 text-sm font-medium">
  {tabs.map((t) => (
    <a
      href={t.href}
      class:list={[
        "rounded-full px-4 py-1.5",
        t.key === active ? "bg-surface-secondary text-text-primary" : "text-text-secondary hover:text-text-primary",
      ]}
    >
      {t.label}
    </a>
  ))}
</nav>
