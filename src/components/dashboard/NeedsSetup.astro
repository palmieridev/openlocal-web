---
import { Icon } from "astro-icon/components";
import { OrganizationSwitcher } from "@clerk/astro/components";
import Button from "@/components/ui/Button.astro";
import { localePath, useT } from "@/i18n";

interface Props {
    /** Distinguish "no business yet" from "data unavailable". */
    reason?: "no-business" | "error";
}
const locale = Astro.locals.locale;
const t = useT(locale).needsSetup;
const to = (href: string) => localePath(locale, href);

const { reason = "no-business" } = Astro.props;
---

<div
    class="mx-auto flex max-w-md flex-col items-center gap-4 px-6 py-20 text-center"
>
    <span
        class="flex size-14 items-center justify-center rounded-2xl bg-accent-soft"
    >
        <Icon
            name={reason === "error" ? "lucide:cloud-off" : "lucide:store"}
            class="text-accent"
            width={28}
            height={28}
        />
    </span>
    {
        reason === "error" ? (
            <>
                <h2 class="font-heading text-xl font-semibold">{t.errorTitle}</h2>
                <p class="text-sm text-text-secondary">{t.errorBody}</p>
                <Button variant="secondary" href={to("/dashboard")}>
                    {t.retry}
                </Button>
            </>
        ) : (
            <>
                <h2 class="font-heading text-xl font-semibold">{t.setupTitle}</h2>
                <p class="text-sm text-text-secondary">{t.setupBody}</p>
                <div class="flex flex-col items-center gap-2 rounded-lg border border-border bg-surface-secondary px-4 py-3">
                    <p class="text-xs text-text-secondary">{t.orgHint}</p>
                    <OrganizationSwitcher
                        hidePersonal
                        afterSelectOrganizationUrl={to("/dashboard")}
                        afterCreateOrganizationUrl={to("/dashboard")}
                    />
                </div>
                <Button variant="primary" href={to("/onboarding")} icon="lucide:store">
                    {t.createBusiness}
                </Button>
            </>
        )
    }
</div>
