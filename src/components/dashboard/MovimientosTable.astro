---
import { Icon } from "astro-icon/components";
import Button from "@/components/ui/Button.astro";
import { useT } from "@/i18n";

export interface MovRow {
  id: string;
  variantId: string;
  movementType: string;
  rawQty: string;
  unitCost: string;
  notes: string;
  name: string;
  sku: string;
  badge: { label: string; badge: string };
  qty: { text: string; tone: "up" | "down" };
  origen: string;
  date: string;
}
interface Props {
  rows: MovRow[];
}
const t = useT(Astro.locals.locale).inventory;

const { rows } = Astro.props;
---

{rows.length > 0 ? (
  <div class="ol-card overflow-hidden">
    <div class="overflow-x-auto">
    <table class="w-full min-w-[560px] text-sm">
      <thead>
        <tr class="border-b border-border text-left text-xs uppercase tracking-wide text-text-muted">
          <th class="px-5 py-3 font-medium">{t.colProduct}</th>
          <th class="px-5 py-3 font-medium">{t.colType}</th>
          <th class="px-5 py-3 text-right font-medium">{t.colQuantity}</th>
          <th class="px-5 py-3 font-medium">{t.colSource}</th>
          <th class="px-5 py-3 text-right font-medium">{t.colDate}</th>
        </tr>
      </thead>
      <tbody id="ledger-body" class="divide-y divide-border">
        {rows.map((r) => (
          <tr
            class="ledger-row cursor-pointer hover:bg-surface-primary/50"
            data-search={`${r.name} ${r.sku}`.toLowerCase()}
            data-csv={JSON.stringify([r.name, r.sku, r.badge.label, r.qty.text, r.origen, r.date])}
            data-move-id={r.id}
            data-variant-id={r.variantId}
            data-vname={r.name}
            data-vsku={r.sku}
            data-type={r.movementType}
            data-qty={r.rawQty}
            data-cost={r.unitCost}
            data-notes={r.notes}
          >
            <td class="px-5 py-3">
              <div class="font-medium text-text-primary">{r.name}</div>
              {r.sku && <div class="font-data text-[11px] text-text-muted">{r.sku}</div>}
            </td>
            <td class="px-5 py-3">
              <span class={`inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${r.badge.badge}`}>{r.badge.label}</span>
            </td>
            <td class={`px-5 py-3 text-right font-data font-semibold ${r.qty.tone === "down" ? "text-danger" : "text-success"}`}>{r.qty.text}</td>
            <td class="px-5 py-3 text-text-secondary">{r.origen}</td>
            <td class="px-5 py-3 text-right text-xs text-text-muted">{r.date}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
    <p id="ledger-empty" class="hidden px-5 py-10 text-center text-sm text-text-muted">
      {t.noMovementMatches}
    </p>
  </div>
) : (
  <div class="ol-card border-dashed p-12 text-center">
    <Icon name="lucide:arrow-left-right" class="mx-auto text-text-muted" width={32} height={32} />
    <p class="mt-3 text-sm text-text-secondary">{t.noMovements}</p>
    <Button variant="primary" size="sm" data-open-picker class="mt-4">{t.logFirst}</Button>
  </div>
)}
