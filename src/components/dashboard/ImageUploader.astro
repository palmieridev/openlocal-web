---
import { Icon } from "astro-icon/components";
import { useT } from "@/i18n";

/**
 * Image upload control, with an optional crop/position step.
 *
 * Two modes:
 *
 * - **Crop (`crop` — the default).** For images the layout forces into a fixed
 *   aspect: the storefront cover banner and the square logo. Picking a file
 *   opens a cropper whose viewport matches the display aspect, the owner
 *   pans/zooms, and only the visible region is encoded and uploaded. That also
 *   normalises EXIF rotation and shrinks multi-MB camera files.
 * - **Original (`crop={false}`).** For product/variant photos, which are shown
 *   whole (`object-contain`) rather than centre-cropped. The picked file is
 *   uploaded byte-for-byte, so nothing is lost and — just as importantly —
 *   nothing has to be decoded in the browser first, which is what used to fail
 *   on Android. Only a file over the 5 MB cap is re-encoded, and then it is
 *   scaled down whole, never cropped.
 *
 * `target` picks where the bytes go: "blob" posts to /api/upload (Vercel Blob),
 * "clerk-logo" calls Clerk's organization.setLogo — the org image is owned by
 * Clerk, not by our storage. Either way the resulting URL lands in a hidden
 * field so the owning form persists it on save.
 */
interface Props {
    /** Unique id; the hidden field is exposed as `${id}-url`. */
    id: string;
    /** Blob path label (a-z only), e.g. "cover" or "product". */
    kind: string;
    /** Current image URL, if any. */
    value?: string | null;
    /** Crop viewport aspect (width / height). Ignored when `crop` is false. */
    aspect?: number;
    /** Encoded width in px; height follows from `aspect`. */
    outputWidth?: number;
    /** Encoded MIME type — PNG keeps logo transparency. */
    outputType?: "image/jpeg" | "image/png";
    /** Height class for the drop zone. */
    heightClass?: string;
    /** Render the drop zone as a square tile (logos). */
    square?: boolean;
    label?: string;
    hint?: string;
    target?: "blob" | "clerk-logo";
    /** false → upload the original file untouched, with no crop step. */
    crop?: boolean;
    /** Preview fit. Defaults to `contain` in original mode, `cover` otherwise. */
    previewFit?: "cover" | "contain";
    /**
     * Original mode only: longest edge kept when a file over the size cap has
     * to be shrunk. Big enough for a full-bleed storefront photo.
     */
    maxDimension?: number;
    /**
     * Narrowest / widest aspect this image is displayed at across breakpoints.
     * The storefront cover is ~2:1 on a phone but ~5:1 on a desktop, so no single
     * crop is shown whole everywhere. When both are given the cropper draws the
     * region that survives on every screen.
     */
    safeMinAspect?: number;
    safeMaxAspect?: number;
}

const {
    id,
    kind,
    value,
    aspect = 3,
    outputWidth = 1500,
    outputType = "image/jpeg",
    heightClass = "h-40",
    square = false,
    label,
    hint,
    target = "blob",
    crop = true,
    previewFit = crop ? "cover" : "contain",
    maxDimension = 2000,
    safeMinAspect,
    safeMaxAspect,
} = Astro.props;
const url = value ?? "";
const dict = useT(Astro.locals.locale);
const iu = dict.imageUploader;
const defaultHint = crop ? iu.hintCrop : iu.hintOriginal;
---

<div
    data-image-uploader
    data-id={id}
    data-kind={kind}
    data-aspect={aspect}
    data-output-width={outputWidth}
    data-output-type={outputType}
    data-target={target}
    data-crop={String(crop)}
    data-max-dimension={maxDimension}
    data-safe-min={safeMinAspect}
    data-safe-max={safeMaxAspect}
>
    {label && <p class="mb-1.5 text-sm font-medium">{label}</p>}
    <input type="hidden" id={`${id}-url`} data-url value={url} />
    <label
        class:list={[
            "group relative flex cursor-pointer flex-col items-center justify-center gap-1.5 overflow-hidden border border-dashed border-border bg-surface-secondary/50 text-text-muted transition-colors hover:border-accent hover:text-accent",
            square ? "size-24 rounded-2xl" : `w-full rounded-xl ${heightClass}`,
        ]}
    >
        <img
            data-preview
            src={url || undefined}
            alt=""
            class:list={[
                "absolute inset-0 size-full",
                previewFit === "contain" ? "object-contain" : "object-cover",
                { hidden: !url },
            ]}
        />
        <div
            data-placeholder
            class:list={[
                "flex flex-col items-center gap-1.5",
                { hidden: !!url },
            ]}
        >
            <Icon name="lucide:image-plus" width={22} height={22} />
            <span class="text-xs">{iu.upload}</span>
        </div>
        <span
            data-uploading
            class="absolute inset-0 hidden items-center justify-center bg-surface-card/80 text-xs font-medium text-text-secondary"
        >
            {iu.uploading}
        </span>
        <input
            data-input
            type="file"
            accept="image/png,image/jpeg,image/webp,image/avif"
            class="sr-only"
        />
    </label>
    <div class="mt-2 flex items-center justify-between gap-2">
        <p class="text-xs text-text-muted">
            {hint ?? defaultHint}
        </p>
        <button
            type="button"
            data-remove
            class:list={[
                "text-xs font-medium text-danger hover:underline",
                { hidden: !url },
            ]}
        >
            Quitar imagen
        </button>
    </div>
    <p data-msg class="mt-2 hidden rounded-xl px-3 py-2 text-sm"></p>

    {
        /* Crop / position modal — only rendered in crop mode. Scrolls as a
           whole so its buttons stay reachable on a short phone screen. */
    }
    {
        crop && (
            <div
                data-crop-modal
                class="fixed inset-0 z-50 hidden items-start justify-center overflow-y-auto overscroll-contain bg-black/50 p-4"
            >
                <div class="ol-card my-auto flex w-full max-w-lg flex-col gap-4 p-5 shadow-xl">
                    <div>
                        <h2 class="font-heading font-semibold">
                            Acomoda la imagen
                        </h2>
                        <p class="text-sm text-text-secondary">
                            Arrastra para mover y usa el control para acercar.
                            Solo se guarda lo que se ve en el recuadro.
                        </p>
                    </div>
                    <div
                        data-crop-viewport
                        class="relative w-full touch-none overflow-hidden rounded-xl bg-surface-secondary select-none"
                    >
                        <img
                            data-crop-image
                            alt=""
                            class="absolute max-w-none origin-top-left will-change-transform"
                        />
                        {
                            /* Region that stays visible at every breakpoint (see safeMinAspect). */
                        }
                        <div
                            data-crop-safe
                            class="pointer-events-none absolute hidden rounded-sm border border-dashed border-white/80 shadow-[0_0_0_9999px_rgba(0,0,0,0.18)]"
                        />
                    </div>
                    <label class="flex items-center gap-3 text-sm text-text-secondary">
                        <Icon name="lucide:zoom-in" width={16} height={16} />
                        <input
                            data-zoom
                            type="range"
                            min="1"
                            max="4"
                            step="0.01"
                            value="1"
                            class="w-full"
                        />
                    </label>
                    <div class="flex items-center justify-end gap-2 border-t border-border pt-4">
                        <button
                            type="button"
                            data-crop-cancel
                            class="rounded-xl border border-border px-4 py-2 text-sm font-medium text-text-secondary hover:bg-surface-secondary"
                        >
                            {dict.common.cancel}
                        </button>
                        <button
                            type="button"
                            data-crop-confirm
                            class="rounded-xl bg-accent px-4 py-2 text-sm font-semibold text-text-inverse hover:opacity-90"
                        >
                            <span data-crop-label>{iu.useImage}</span>
                        </button>
                    </div>
                </div>
            </div>
        )
    }
</div>

<script>
    import {
        MAX_IMAGE_BYTES,
        validateImageType,
        validateImageUpload,
    } from "@/lib/upload";
    import {
        imageDecodeMessage,
        decodeImage,
        fitWithin,
        type DecodedImage,
    } from "@/lib/image-source";
    import { ui, uiLocale } from "@/lib/i18n-client";

    const t = ui().imageUploader;
    const locale = uiLocale();

    document
        .querySelectorAll<HTMLElement>("[data-image-uploader]")
        .forEach((root) => {
            const kind = root.dataset.kind || "image";
            const aspect = Number(root.dataset.aspect) || 3;
            const outputWidth = Number(root.dataset.outputWidth) || 1500;
            const outputType = root.dataset.outputType || "image/jpeg";
            const target = root.dataset.target || "blob";
            const cropMode = root.dataset.crop !== "false";
            const maxDimension = Number(root.dataset.maxDimension) || 2000;

            const q = <T extends HTMLElement>(sel: string) =>
                root.querySelector<T>(sel)!;
            const urlEl = q<HTMLInputElement>("[data-url]");
            const input = q<HTMLInputElement>("[data-input]");
            const preview = q<HTMLImageElement>("[data-preview]");
            const placeholder = q("[data-placeholder]");
            const uploading = q("[data-uploading]");
            const removeBtn = q("[data-remove]");
            const msg = q("[data-msg]");

            function flash(ok: boolean, text: string) {
                msg.textContent = text;
                msg.className = `mt-2 rounded-xl px-3 py-2 text-sm ${ok ? "bg-success-soft text-success" : "bg-danger-soft text-danger"}`;
            }

            function setUrl(next: string) {
                urlEl.value = next;
                preview.src = next;
                preview.classList.toggle("hidden", !next);
                placeholder.classList.toggle("hidden", !!next);
                removeBtn.classList.toggle("hidden", !next);
                root.dispatchEvent(
                    new CustomEvent("image-change", {
                        detail: next,
                        bubbles: true,
                    }),
                );
            }

            /** Upload `file` and reflect the outcome in the control. */
            async function send(file: File, okText: string) {
                placeholder.classList.add("hidden");
                uploading.classList.remove("hidden");
                uploading.classList.add("flex");
                try {
                    setUrl(await store(file));
                    flash(true, okText);
                } catch (err) {
                    placeholder.classList.toggle(
                        "hidden",
                        Boolean(urlEl.value),
                    );
                    flash(
                        false,
                        err instanceof Error
                            ? err.message
                            : t.uploadFailed,
                    );
                } finally {
                    uploading.classList.add("hidden");
                    uploading.classList.remove("flex");
                }
            }

            /** Encode a whole decoded image at `width`×`height`. No cropping. */
            async function encodeWhole(
                decoded: DecodedImage,
                width: number,
                height: number,
                quality: number,
            ): Promise<Blob | null> {
                const canvas = document.createElement("canvas");
                canvas.width = width;
                canvas.height = height;
                const ctx = canvas.getContext("2d");
                if (!ctx) return null;
                ctx.drawImage(decoded.source, 0, 0, width, height);
                return new Promise<Blob | null>((resolve) =>
                    canvas.toBlob(resolve, "image/jpeg", quality),
                );
            }

            /**
             * Last resort for an original over the 5 MB cap: scale the *whole*
             * frame down until it fits, dropping quality first so the picture
             * keeps as many pixels as possible.
             */
            async function shrinkToFit(file: File): Promise<File> {
                const decoded = await decodeImage(file);
                try {
                    let { width, height } = fitWithin(
                        decoded.width,
                        decoded.height,
                        maxDimension,
                    );
                    for (const quality of [0.88, 0.78, 0.68, 0.6]) {
                        const blob = await encodeWhole(
                            decoded,
                            width,
                            height,
                            quality,
                        );
                        if (blob && blob.size <= MAX_IMAGE_BYTES) {
                            return new File([blob], `${kind}.jpg`, {
                                type: "image/jpeg",
                            });
                        }
                        ({ width, height } = fitWithin(
                            width,
                            height,
                            Math.round(Math.max(width, height) * 0.75),
                        ));
                    }
                    throw new Error(t.tooHeavy);
                } finally {
                    decoded.release();
                }
            }

            /** Original mode: upload the picked bytes as they are. */
            async function useOriginal(file: File) {
                input.value = "";
                let payload: File = file;
                if (file.size > MAX_IMAGE_BYTES) {
                    try {
                        payload = await shrinkToFit(file);
                    } catch (err) {
                        flash(
                            false,
                            err instanceof Error
                                ? err.message
                                : imageDecodeMessage(locale),
                        );
                        return;
                    }
                }
                await send(
                    payload,
                    t.imageReady,
                );
            }

            input.addEventListener("change", async () => {
                const file = input.files?.[0];
                if (!file) return;
                msg.classList.add("hidden");
                // In original mode an oversized file is recoverable (it gets
                // scaled down), so only the format check is fatal there.
                const problem = cropMode
                    ? validateImageUpload(file, locale)
                    : validateImageType(file, locale);
                if (problem) {
                    flash(false, problem);
                    input.value = "";
                    return;
                }
                if (!cropMode) {
                    await useOriginal(file);
                    return;
                }
                await openCropper(file);
            });

            /** Persist the bytes and return the public URL. */
            async function store(file: File): Promise<string> {
                if (target === "clerk-logo") {
                    const clerk = (window as any).Clerk;
                    const organization = clerk?.organization;
                    if (!organization?.setLogo) {
                        throw new Error(t.noOrganization);
                    }
                    const updated = await organization.setLogo({ file });
                    const imageUrl = updated?.imageUrl || organization.imageUrl;
                    if (!imageUrl)
                        throw new Error(t.clerkNoUrl);
                    return imageUrl;
                }
                const fd = new FormData();
                fd.append("file", file);
                fd.append("kind", kind);
                fd.append("locale", locale);
                const res = await fetch("/api/upload", {
                    method: "POST",
                    body: fd,
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok)
                    throw new Error(data?.error || t.storeFailed);
                return data.url;
            }

            removeBtn.addEventListener("click", () => {
                setUrl("");
                flash(true, t.willBeRemoved);
            });

            // Lets a host page load a value in — needed when one uploader is
            // reused by a shared modal (the variant editor switches between
            // variants without re-rendering the control).
            root.addEventListener("image-set", (e) => {
                msg.classList.add("hidden");
                setUrl((e as CustomEvent<string>).detail || "");
            });

            // Store a file the host produced elsewhere (a generated logo
            // preset), skipping the crop step since it is already square.
            root.addEventListener("image-file", async (e) => {
                const file = (e as CustomEvent<File>).detail;
                if (!file) return;
                msg.classList.add("hidden");
                await send(
                    file,
                    t.logoReady,
                );
            });

            // ── Crop mode ───────────────────────────────────────────────────────────
            let openCropper = async (_file: File) => {};
            if (!cropMode) return;

            const modal = q("[data-crop-modal]");
            const viewport = q("[data-crop-viewport]");
            const cropImage = q<HTMLImageElement>("[data-crop-image]");
            const safeArea = q("[data-crop-safe]");
            const zoom = q<HTMLInputElement>("[data-zoom]");

            // `scale` maps source pixels → viewport pixels; tx/ty are the image's
            // top-left offset inside the viewport, clamped so it always covers it.
            let decoded: DecodedImage | null = null;
            let objectUrl = "";
            let minScale = 1;
            let scale = 1;
            let tx = 0;
            let ty = 0;

            function viewportSize() {
                const width = viewport.clientWidth;
                return { width, height: width / aspect };
            }

            function clamp() {
                const { width, height } = viewportSize();
                const w = (decoded?.width ?? 0) * scale;
                const h = (decoded?.height ?? 0) * scale;
                tx = Math.min(0, Math.max(width - w, tx));
                ty = Math.min(0, Math.max(height - h, ty));
            }

            function paint() {
                if (!decoded) return;
                cropImage.style.width = `${decoded.width * scale}px`;
                cropImage.style.height = `${decoded.height * scale}px`;
                cropImage.style.transform = `translate(${tx}px, ${ty}px)`;
            }

            function fit() {
                if (!decoded) return;
                const { width, height } = viewportSize();
                viewport.style.height = `${height}px`;
                minScale = Math.max(
                    width / decoded.width,
                    height / decoded.height,
                );
                scale = minScale * Number(zoom.value);
                // Start centred on the middle of the photo.
                tx = (width - decoded.width * scale) / 2;
                ty = (height - decoded.height * scale) / 2;
                clamp();
                paint();
            }

            function closeModal() {
                modal.classList.add("hidden");
                modal.classList.remove("flex");
                if (objectUrl) URL.revokeObjectURL(objectUrl);
                objectUrl = "";
                decoded?.release();
                decoded = null;
                input.value = "";
            }

            openCropper = async (file: File) => {
                try {
                    decoded = await decodeImage(file);
                } catch {
                    flash(false, imageDecodeMessage(locale));
                    input.value = "";
                    return;
                }
                objectUrl = URL.createObjectURL(file);
                cropImage.src = objectUrl;
                zoom.value = "1";
                modal.classList.remove("hidden");
                modal.classList.add("flex");
                // The viewport has no width until it is displayed.
                requestAnimationFrame(() => {
                    fit();
                    // Narrow screens trim the sides, wide ones trim top and bottom; the
                    // intersection is what every visitor is guaranteed to see.
                    const safeMin = Number(root.dataset.safeMin);
                    const safeMax = Number(root.dataset.safeMax);
                    if (safeMin > 0 && safeMax > 0) {
                        const inset = (fraction: number) =>
                            `${((1 - Math.min(1, fraction)) / 2) * 100}%`;
                        const x = inset(safeMin / aspect);
                        const y = inset(aspect / safeMax);
                        safeArea.style.left = x;
                        safeArea.style.right = x;
                        safeArea.style.top = y;
                        safeArea.style.bottom = y;
                        safeArea.classList.remove("hidden");
                    }
                });
            };

            // Pan.
            let dragging = false;
            let lastX = 0;
            let lastY = 0;
            viewport.addEventListener("pointerdown", (e) => {
                if (!decoded) return;
                dragging = true;
                lastX = e.clientX;
                lastY = e.clientY;
                viewport.setPointerCapture(e.pointerId);
            });
            viewport.addEventListener("pointermove", (e) => {
                if (!dragging) return;
                tx += e.clientX - lastX;
                ty += e.clientY - lastY;
                lastX = e.clientX;
                lastY = e.clientY;
                clamp();
                paint();
            });
            const endDrag = () => {
                dragging = false;
            };
            viewport.addEventListener("pointerup", endDrag);
            viewport.addEventListener("pointercancel", endDrag);

            // Zoom about the viewport centre.
            zoom.addEventListener("input", () => {
                if (!decoded) return;
                const { width, height } = viewportSize();
                const previous = scale;
                scale = minScale * Number(zoom.value);
                const ratio = scale / previous;
                tx = width / 2 - (width / 2 - tx) * ratio;
                ty = height / 2 - (height / 2 - ty) * ratio;
                clamp();
                paint();
            });

            q("[data-crop-cancel]").addEventListener("click", closeModal);
            modal.addEventListener("click", (e) => {
                if (e.target === modal) closeModal();
            });

            q("[data-crop-confirm]").addEventListener("click", async () => {
                if (!decoded) return;
                const { width, height } = viewportSize();
                // Viewport rect expressed in source pixels.
                const sx = -tx / scale;
                const sy = -ty / scale;
                const sw = width / scale;
                const sh = height / scale;

                const canvas = document.createElement("canvas");
                canvas.width = outputWidth;
                canvas.height = Math.round(outputWidth / aspect);
                const ctx = canvas.getContext("2d");
                if (!ctx) return;
                ctx.drawImage(
                    decoded.source,
                    sx,
                    sy,
                    sw,
                    sh,
                    0,
                    0,
                    canvas.width,
                    canvas.height,
                );

                const blob = await new Promise<Blob | null>((resolve) =>
                    canvas.toBlob(resolve, outputType, 0.9),
                );
                if (!blob) {
                    flash(false, t.processFailed);
                    return;
                }
                if (blob.size > MAX_IMAGE_BYTES) {
                    flash(false, ui().upload.tooLarge);
                    return;
                }
                const ext = outputType === "image/png" ? "png" : "jpg";
                const file = new File([blob], `${kind}.${ext}`, {
                    type: outputType,
                });

                closeModal();
                await send(
                    file,
                    t.imageReady,
                );
            });
        });
</script>
