---
import { Icon } from "astro-icon/components";

/**
 * Image upload control with a crop/position step.
 *
 * Phone photos are portrait (or 4:3) while the storefront renders wide banners
 * and fixed-height cards, so a raw upload gets centre-cropped by CSS and the
 * subject falls outside the frame. Picking a file therefore opens a cropper
 * whose viewport matches the display aspect: the owner pans/zooms, and only the
 * visible region is encoded and uploaded. That also normalises EXIF rotation
 * and shrinks multi-MB camera files.
 *
 * `target` picks where the bytes go: "blob" posts to /api/upload (Vercel Blob),
 * "clerk-logo" calls Clerk's organization.setLogo — the org image is owned by
 * Clerk, not by our storage. Either way the resulting URL lands in a hidden
 * field so the owning form persists it on save.
 */
interface Props {
    /** Unique id; the hidden field is exposed as `${id}-url`. */
    id: string;
    /** Blob path label (a-z only), e.g. "cover" or "product". */
    kind: string;
    /** Current image URL, if any. */
    value?: string | null;
    /** Crop viewport aspect (width / height). */
    aspect?: number;
    /** Encoded width in px; height follows from `aspect`. */
    outputWidth?: number;
    /** Encoded MIME type — PNG keeps logo transparency. */
    outputType?: "image/jpeg" | "image/png";
    /** Height class for the drop zone. */
    heightClass?: string;
    /** Render the drop zone as a square tile (logos). */
    square?: boolean;
    label?: string;
    hint?: string;
    target?: "blob" | "clerk-logo";
    /**
     * Narrowest / widest aspect this image is displayed at across breakpoints.
     * The storefront cover is ~2:1 on a phone but ~5:1 on a desktop, so no single
     * crop is shown whole everywhere. When both are given the cropper draws the
     * region that survives on every screen.
     */
    safeMinAspect?: number;
    safeMaxAspect?: number;
}

const {
    id,
    kind,
    value,
    aspect = 3,
    outputWidth = 1500,
    outputType = "image/jpeg",
    heightClass = "h-40",
    square = false,
    label,
    hint,
    target = "blob",
    safeMinAspect,
    safeMaxAspect,
} = Astro.props;
const url = value ?? "";
---

<div
    data-image-uploader
    data-id={id}
    data-kind={kind}
    data-aspect={aspect}
    data-output-width={outputWidth}
    data-output-type={outputType}
    data-target={target}
    data-safe-min={safeMinAspect}
    data-safe-max={safeMaxAspect}
>
    {label && <p class="mb-1.5 text-sm font-medium">{label}</p>}
    <input type="hidden" id={`${id}-url`} data-url value={url} />
    <label
        class:list={[
            "group relative flex cursor-pointer flex-col items-center justify-center gap-1.5 overflow-hidden border border-dashed border-border bg-surface-secondary/50 text-text-muted transition-colors hover:border-accent hover:text-accent",
            square ? "size-24 rounded-2xl" : `w-full rounded-xl ${heightClass}`,
        ]}
    >
        <img
            data-preview
            src={url || undefined}
            alt=""
            class:list={[
                "absolute inset-0 size-full object-cover",
                { hidden: !url },
            ]}
        />
        <div
            data-placeholder
            class:list={[
                "flex flex-col items-center gap-1.5",
                { hidden: !!url },
            ]}
        >
            <Icon name="lucide:image-plus" width={22} height={22} />
            <span class="text-xs">Subir imagen</span>
        </div>
        <span
            data-uploading
            class="absolute inset-0 hidden items-center justify-center bg-surface-card/80 text-xs font-medium text-text-secondary"
        >
            Subiendo…
        </span>
        <input
            data-input
            type="file"
            accept="image/png,image/jpeg,image/webp,image/avif"
            class="sr-only"
        />
    </label>
    <div class="mt-2 flex items-center justify-between gap-2">
        <p class="text-xs text-text-muted">
            {hint ?? "JPG, PNG, WebP o AVIF · máx 5 MB"}
        </p>
        <button
            type="button"
            data-remove
            class:list={[
                "text-xs font-medium text-danger hover:underline",
                { hidden: !url },
            ]}
        >
            Quitar imagen
        </button>
    </div>
    <p data-msg class="mt-2 hidden rounded-xl px-3 py-2 text-sm"></p>

    {/* Crop / position modal */}
    <div
        data-crop-modal
        class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
    >
        <div class="ol-card flex w-full max-w-lg flex-col gap-4 p-5 shadow-xl">
            <div>
                <h2 class="font-heading font-semibold">Acomoda la imagen</h2>
                <p class="text-sm text-text-secondary">
                    Arrastra para mover y usa el control para acercar. Solo se
                    guarda lo que se ve en el recuadro.
                </p>
            </div>
            <div
                data-crop-viewport
                class="relative w-full touch-none overflow-hidden rounded-xl bg-surface-secondary select-none"
            >
                <img
                    data-crop-image
                    alt=""
                    class="absolute max-w-none origin-top-left will-change-transform"
                />
                {
                    /* Region that stays visible at every breakpoint (see safeMinAspect). */
                }
                <div
                    data-crop-safe
                    class="pointer-events-none absolute hidden rounded-sm border border-dashed border-white/80 shadow-[0_0_0_9999px_rgba(0,0,0,0.18)]"
                >
                </div>
            </div>
            <label class="flex items-center gap-3 text-sm text-text-secondary">
                <Icon name="lucide:zoom-in" width={16} height={16} />
                <input
                    data-zoom
                    type="range"
                    min="1"
                    max="4"
                    step="0.01"
                    value="1"
                    class="w-full"
                />
            </label>
            <div
                class="flex items-center justify-end gap-2 border-t border-border pt-4"
            >
                <button
                    type="button"
                    data-crop-cancel
                    class="rounded-xl border border-border px-4 py-2 text-sm font-medium text-text-secondary hover:bg-surface-secondary"
                >
                    Cancelar
                </button>
                <button
                    type="button"
                    data-crop-confirm
                    class="rounded-xl bg-accent px-4 py-2 text-sm font-semibold text-text-inverse hover:opacity-90"
                >
                    <span data-crop-label>Usar imagen</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    import { MAX_IMAGE_BYTES, validateImageUpload } from "@/lib/upload";

    document
        .querySelectorAll<HTMLElement>("[data-image-uploader]")
        .forEach((root) => {
            const kind = root.dataset.kind || "image";
            const aspect = Number(root.dataset.aspect) || 3;
            const outputWidth = Number(root.dataset.outputWidth) || 1500;
            const outputType = root.dataset.outputType || "image/jpeg";
            const target = root.dataset.target || "blob";

            const q = <T extends HTMLElement>(sel: string) =>
                root.querySelector<T>(sel)!;
            const urlEl = q<HTMLInputElement>("[data-url]");
            const input = q<HTMLInputElement>("[data-input]");
            const preview = q<HTMLImageElement>("[data-preview]");
            const placeholder = q("[data-placeholder]");
            const uploading = q("[data-uploading]");
            const removeBtn = q("[data-remove]");
            const msg = q("[data-msg]");
            const modal = q("[data-crop-modal]");
            const viewport = q("[data-crop-viewport]");
            const cropImage = q<HTMLImageElement>("[data-crop-image]");
            const safeArea = q("[data-crop-safe]");
            const zoom = q<HTMLInputElement>("[data-zoom]");

            function flash(ok: boolean, text: string) {
                msg.textContent = text;
                msg.className = `mt-2 rounded-xl px-3 py-2 text-sm ${ok ? "bg-success-soft text-success" : "bg-danger-soft text-danger"}`;
            }

            function setUrl(next: string) {
                urlEl.value = next;
                preview.src = next;
                preview.classList.toggle("hidden", !next);
                placeholder.classList.toggle("hidden", !!next);
                removeBtn.classList.toggle("hidden", !next);
                root.dispatchEvent(
                    new CustomEvent("image-change", {
                        detail: next,
                        bubbles: true,
                    }),
                );
            }

            // ── Crop state ──────────────────────────────────────────────────────────
            // `scale` maps source pixels → viewport pixels; tx/ty are the image's
            // top-left offset inside the viewport, clamped so it always covers it.
            let bitmap: ImageBitmap | null = null;
            let objectUrl = "";
            let minScale = 1;
            let scale = 1;
            let tx = 0;
            let ty = 0;

            function viewportSize() {
                const width = viewport.clientWidth;
                return { width, height: width / aspect };
            }

            function clamp() {
                const { width, height } = viewportSize();
                const w = (bitmap?.width ?? 0) * scale;
                const h = (bitmap?.height ?? 0) * scale;
                tx = Math.min(0, Math.max(width - w, tx));
                ty = Math.min(0, Math.max(height - h, ty));
            }

            function paint() {
                if (!bitmap) return;
                cropImage.style.width = `${bitmap.width * scale}px`;
                cropImage.style.height = `${bitmap.height * scale}px`;
                cropImage.style.transform = `translate(${tx}px, ${ty}px)`;
            }

            function fit() {
                if (!bitmap) return;
                const { width, height } = viewportSize();
                viewport.style.height = `${height}px`;
                minScale = Math.max(
                    width / bitmap.width,
                    height / bitmap.height,
                );
                scale = minScale * Number(zoom.value);
                // Start centred on the middle of the photo.
                tx = (width - bitmap.width * scale) / 2;
                ty = (height - bitmap.height * scale) / 2;
                clamp();
                paint();
            }

            function closeModal() {
                modal.classList.add("hidden");
                modal.classList.remove("flex");
                if (objectUrl) URL.revokeObjectURL(objectUrl);
                objectUrl = "";
                bitmap?.close();
                bitmap = null;
                input.value = "";
            }

            input.addEventListener("change", async () => {
                const file = input.files?.[0];
                if (!file) return;
                msg.classList.add("hidden");
                const problem = validateImageUpload(file);
                if (problem) {
                    flash(false, problem);
                    input.value = "";
                    return;
                }
                try {
                    // `from-image` applies EXIF rotation, which phone cameras rely on.
                    bitmap = await createImageBitmap(file, {
                        imageOrientation: "from-image",
                    });
                } catch {
                    flash(false, "No se pudo leer la imagen.");
                    input.value = "";
                    return;
                }
                objectUrl = URL.createObjectURL(file);
                cropImage.src = objectUrl;
                zoom.value = "1";
                modal.classList.remove("hidden");
                modal.classList.add("flex");
                // The viewport has no width until it is displayed.
                requestAnimationFrame(() => {
                    fit();
                    // Narrow screens trim the sides, wide ones trim top and bottom; the
                    // intersection is what every visitor is guaranteed to see.
                    const safeMin = Number(root.dataset.safeMin);
                    const safeMax = Number(root.dataset.safeMax);
                    if (safeMin > 0 && safeMax > 0) {
                        const inset = (fraction: number) =>
                            `${((1 - Math.min(1, fraction)) / 2) * 100}%`;
                        const x = inset(safeMin / aspect);
                        const y = inset(aspect / safeMax);
                        safeArea.style.left = x;
                        safeArea.style.right = x;
                        safeArea.style.top = y;
                        safeArea.style.bottom = y;
                        safeArea.classList.remove("hidden");
                    }
                });
            });

            // Pan.
            let dragging = false;
            let lastX = 0;
            let lastY = 0;
            viewport.addEventListener("pointerdown", (e) => {
                if (!bitmap) return;
                dragging = true;
                lastX = e.clientX;
                lastY = e.clientY;
                viewport.setPointerCapture(e.pointerId);
            });
            viewport.addEventListener("pointermove", (e) => {
                if (!dragging) return;
                tx += e.clientX - lastX;
                ty += e.clientY - lastY;
                lastX = e.clientX;
                lastY = e.clientY;
                clamp();
                paint();
            });
            const endDrag = () => {
                dragging = false;
            };
            viewport.addEventListener("pointerup", endDrag);
            viewport.addEventListener("pointercancel", endDrag);

            // Zoom about the viewport centre.
            zoom.addEventListener("input", () => {
                if (!bitmap) return;
                const { width, height } = viewportSize();
                const previous = scale;
                scale = minScale * Number(zoom.value);
                const ratio = scale / previous;
                tx = width / 2 - (width / 2 - tx) * ratio;
                ty = height / 2 - (height / 2 - ty) * ratio;
                clamp();
                paint();
            });

            q("[data-crop-cancel]").addEventListener("click", closeModal);
            modal.addEventListener("click", (e) => {
                if (e.target === modal) closeModal();
            });

            q("[data-crop-confirm]").addEventListener("click", async () => {
                if (!bitmap) return;
                const { width, height } = viewportSize();
                // Viewport rect expressed in source pixels.
                const sx = -tx / scale;
                const sy = -ty / scale;
                const sw = width / scale;
                const sh = height / scale;

                const canvas = document.createElement("canvas");
                canvas.width = outputWidth;
                canvas.height = Math.round(outputWidth / aspect);
                const ctx = canvas.getContext("2d");
                if (!ctx) return;
                ctx.drawImage(
                    bitmap,
                    sx,
                    sy,
                    sw,
                    sh,
                    0,
                    0,
                    canvas.width,
                    canvas.height,
                );

                const blob = await new Promise<Blob | null>((resolve) =>
                    canvas.toBlob(resolve, outputType, 0.9),
                );
                if (!blob) {
                    flash(false, "No se pudo procesar la imagen.");
                    return;
                }
                if (blob.size > MAX_IMAGE_BYTES) {
                    flash(false, "La imagen supera el máximo de 5 MB.");
                    return;
                }
                const ext = outputType === "image/png" ? "png" : "jpg";
                const file = new File([blob], `${kind}.${ext}`, {
                    type: outputType,
                });

                closeModal();
                placeholder.classList.add("hidden");
                uploading.classList.remove("hidden");
                uploading.classList.add("flex");
                try {
                    setUrl(await store(file));
                    flash(
                        true,
                        "Imagen lista. Guarda los cambios para publicarla.",
                    );
                } catch (err) {
                    placeholder.classList.toggle(
                        "hidden",
                        Boolean(urlEl.value),
                    );
                    flash(
                        false,
                        err instanceof Error
                            ? err.message
                            : "Error al subir la imagen.",
                    );
                } finally {
                    uploading.classList.add("hidden");
                    uploading.classList.remove("flex");
                }
            });

            /** Persist the bytes and return the public URL. */
            async function store(file: File): Promise<string> {
                if (target === "clerk-logo") {
                    const clerk = (window as any).Clerk;
                    const organization = clerk?.organization;
                    if (!organization?.setLogo) {
                        throw new Error(
                            "No se pudo acceder a tu organización. Recarga la página.",
                        );
                    }
                    const updated = await organization.setLogo({ file });
                    const imageUrl = updated?.imageUrl || organization.imageUrl;
                    if (!imageUrl)
                        throw new Error("Clerk no devolvió la URL del logo.");
                    return imageUrl;
                }
                const fd = new FormData();
                fd.append("file", file);
                fd.append("kind", kind);
                const res = await fetch("/api/upload", {
                    method: "POST",
                    body: fd,
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok)
                    throw new Error(
                        data?.error || "No se pudo subir la imagen.",
                    );
                return data.url;
            }

            removeBtn.addEventListener("click", () => {
                setUrl("");
                flash(true, "Se quitará al guardar los cambios.");
            });
        });
</script>
