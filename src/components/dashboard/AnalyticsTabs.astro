---
interface Props {
  active: "abc" | "low-stock" | "eoq";
}
const { active } = Astro.props;
const tabs = [
  { key: "abc", label: "ABC / Pareto", href: "/dashboard/analytics" },
  { key: "low-stock", label: "Bajo stock", href: "/dashboard/analytics/low-stock" },
  { key: "eoq", label: "EOQ", href: "/dashboard/analytics/eoq" },
];
---

<nav class="flex flex-wrap gap-1 rounded-full border border-border bg-surface-card p-1 text-sm font-medium">
  {tabs.map((t) => (
    <a
      href={t.href}
      class:list={[
        "rounded-full px-4 py-1.5",
        t.key === active ? "bg-surface-secondary text-text-primary" : "text-text-secondary hover:text-text-primary",
      ]}
    >
      {t.label}
    </a>
  ))}
</nav>
